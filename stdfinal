-- Изолируем дополнительные locals: не увеличиваем их число в основном scope хаба.
do
    local INVOKE_TIMEOUT, CONFIRM_TIMEOUT, TOLERANCE = 12, 8, 0.8
    local function setting(id, fallback, low, high, integral)
        local value = tonumber(opt(id, fallback))
        if not finite(value) then value = fallback end
        value = math.clamp(value, low, high)
        return integral and math.floor(value) or value
    end
    local function numberValue(parent, name)
        local value = parent and parent:FindFirstChild(name)
        if value and (value:IsA("NumberValue") or value:IsA("IntValue"))
            and finite(value.Value) and value.Value >= 0 then
            return value.Value
        end
        return nil
    end
    local function level(model)
        local value = numberValue(model and model:FindFirstChild("Config"), "LVL")
        if value ~= nil and value % 1 == 0 then return value end
        return nil
    end
    local function livePrice(step)
        -- Смена цели бесплатна: порог 0, ожидание Cash и CashSync не требуются.
        if step.kind == "Target" then return 0, "смена цели бесплатна" end
        if step.kind == "Spawn" then
            local name = decode(step.args[1])
            if type(name) ~= "string" then return nil, "Неверное имя Spawn" end
            local catalog = RS:FindFirstChild("Towers")
            local template = catalog and catalog:FindFirstChild(name)
            local price = numberValue(template and template:FindFirstChild("Config"), "Price")
            if price == nil then return nil, "Нет Config.Price шаблона " .. name end
            return price, "Config.Price: " .. name
        end
        local ref = S.playRefs[step.id]
        local model = ref and ref.model
        if not model or model.Parent ~= towers() then return nil, "Нет поставленной башни " .. step.id end
        local price = model:GetAttribute("NextUpgradePrice")
        if not finite(price) or price < 0 then return nil, "Нет корректного NextUpgradePrice: " .. step.id end
        return price, "NextUpgradePrice: " .. step.id
    end

    -- Проверка файла не должна требовать уже поставленных башен / их живых цен.
    -- baseValidate — исходная проверка STD-MONEY, объявлена выше в вашем do-блоке.
    validateMacro = function(data)
        local result = baseValidate(data)
        for _, step in ipairs(result.steps) do
            if step.requiredCash ~= nil then
                assert(finite(step.requiredCash) and step.requiredCash >= 0, "Неверный legacy requiredCash")
            end
        end
        return result
    end
    -- Этот helper используется также существующей диагностикой ниже.
    -- math.huge — ТОЛЬКО отображаемый маркер отсутствующей цены, не отправляемый порог.
    stepThreshold = function(step)
        local price, source = livePrice(step)
        return price ~= nil and price or math.huge, source
    end
    A.blocked, A.skipped, A.completed = {}, 0, 0

    -- Режим цели башни без исключений наружу; nil при отсутствии пути.
    local function targetMode(model)
        local ok, value = pcall(function()
            local config = model and model:FindFirstChild("Config")
            local obj = config and config:FindFirstChild("TargetMode")
            if obj and obj:IsA("StringValue") then return obj.Value end
            return nil
        end)
        return ok and value or nil
    end
    local function near(model, cf)
        local p = pivot(model)
        return p and (p.Position - cf.Position).Magnitude <= TOLERANCE
    end
    local function sameSpawn(model, name)
        return model.Name == name or model:GetAttribute("ID") == name
    end
    local function sameUpgrade(model, ctx)
        local id = model:GetAttribute("ID")
        return model.Name == ctx.step.name or model.Name == ctx.oldName
            or (ctx.oldID ~= nil and id == ctx.oldID)
    end
    local function observed(ctx)
        local folder = towers()
        if not folder or folder ~= ctx.folder then return nil, "Сменился workspace.Towers" end
        local found
        -- Только создание подходящей модели либо рост LVL, а не любой fingerprint.
        for _, model in ipairs(folder:GetChildren()) do
            if model:IsA("Model") and near(model, ctx.cf) then
                local matches
                if ctx.step.kind == "Spawn" then
                    matches = not ctx.before[model] and sameSpawn(model, ctx.name)
                elseif ctx.step.kind == "Upgrade" then
                    local n = level(model)
                    matches = n ~= nil and n > ctx.oldLevel
                        and ((model == ctx.target) or (not ctx.before[model] and sameUpgrade(model, ctx)))
                else
                    -- Target: только та же башня с изменившимся TargetMode.
                    local cur = targetMode(model)
                    matches = (model == ctx.target) and cur ~= nil and ctx.oldMode ~= nil and cur ~= ctx.oldMode
                end
                if matches then
                    if found then return nil, "Неоднозначное подтверждение: несколько башен" end
                    found = model
                end
            end
        end
        return found
    end
    local function observeFor(ctx, seconds, valid)
        local deadline = os.clock() + seconds
        repeat
            if not valid() then return nil, "Остановлено" end
            local model, err = observed(ctx)
            if model or err then return model, err end
            if os.clock() >= deadline then return nil end
            task.wait()
        until false
    end
    local function bindResult(ctx, model)
        S.playRefs[ctx.step.id] = { model = model, cf = pivot(model) or ctx.cf }
    end
    local function prepare(step)
        local remoteName = step.kind == "Spawn" and "SpawnTower"
            or (step.kind == "Target" and "ChangeTowerMode" or "UpgradeTower")
        local r = remote("Functions", remoteName, "RemoteFunction")
        if not r then return nil, "RemoteFunction отсутствует" end
        local folder = towers()
        if not folder then return nil, "Нет workspace.Towers" end
        local ctx = { step = step, remote = r, folder = folder, before = snapshotTowers(), sends = 0 }
        if step.kind == "Spawn" then
            ctx.args = decodeArgs(step.args)
            ctx.name, ctx.cf = ctx.args[1], ctx.args[2]
        elseif step.kind == "Target" then
            local ref = S.playRefs[step.id]
            local target = ref and ref.model
            if not target or target.Parent ~= folder then return nil, "Потеряна башня " .. step.id end
            ctx.target, ctx.cf = target, pivot(target)
            if not ctx.cf then return nil, "Нет позиции башни: " .. step.id end
            ctx.oldMode = targetMode(target)
            if ctx.oldMode == nil then return nil, "Нет Config.TargetMode: " .. step.id end
            ctx.args = table.pack(target)
        else
            local ref = S.playRefs[step.id]
            local target = ref and ref.model
            if not target or target.Parent ~= folder then return nil, "Потеряна башня " .. step.id end
            ctx.target, ctx.cf, ctx.oldLevel = target, pivot(target), level(target)
            if not ctx.cf or ctx.oldLevel == nil then return nil, "Нет позиции или Config.LVL: " .. step.id end
            ctx.oldName, ctx.oldID = target.Name, target:GetAttribute("ID")
            ctx.args = table.pack(target, step.name)
        end
        return ctx
    end

    -- Не переопределяем общий invoke(): speed и остальные модули остаются прежними.
    -- Ticket сохраняет различие между false и неизвестным сетевым исходом.
    local function sendOnce(ctx, valid)
        if S.locks.tower then return "unknown", "Предыдущий tower-запрос ещё выполняется" end
        if not valid() then return "cancel", "Остановлено" end
        -- Снимок непосредственно перед ПЕРВОЙ отправкой, а не до ожидания денег.
        if ctx.sends == 0 then ctx.before = snapshotTowers() end
        local ticket = { done = false }
        S.locks.tower = ticket
        ctx.sends = ctx.sends + 1
        ctx.money, ctx.revision = cashNow(), S.cashVersion
        ctx.cashObject = S.cash
        task.spawn(function()
            local thread = coroutine.running()
            internal[thread] = true
            ticket.result = table.pack(pcall(function()
                -- Все аргументы, включая nil, передаются без изменения сигнатуры.
                return ctx.remote:InvokeServer(table.unpack(ctx.args, 1, ctx.args.n))
            end))
            internal[thread] = nil
            ticket.done = true
            if S.locks.tower == ticket then S.locks.tower = nil end
        end)
        local done, err = waitUntil(function() return ticket.done end, INVOKE_TIMEOUT, valid)
        if not done then
            return valid() and "unknown" or "cancel", tostring(err) .. "; запрос не отозван"
        end
        if not ticket.result[1] then return "unknown", "Исключение InvokeServer; исход неизвестен" end
        if ticket.result[2] == false then return "rejected", "Сервер вернул false" end
        return "returned"
    end
    local function finishPurchase(ctx, model, valid)
        bindResult(ctx, model)
        cashNow()
        if S.cash ~= ctx.cashObject then return "unknown", "Во время покупки заменён объект Cash" end
        if opt("WaitCashSync", true) and ctx.price > 0
            and S.cash == ctx.cashObject and S.cashVersion == ctx.revision then
            phase("CASH_SYNC", "покупка подтверждена; ждём репликацию Cash, без повтора")
            local synced, err = waitUntil(function()
                cashNow()
                return S.cash == ctx.cashObject and S.cashVersion ~= ctx.revision
            end, setting("CashSyncTimeout", 2, 0.25, 8), valid)
            if not synced then
                return valid() and "unknown" or "cancel", "Покупка выполнена, Cash не синхронизирован: " .. tostring(err)
            end
        end
        trace("STEP_DONE", ctx.step.kind .. " " .. ctx.step.id .. "; отправок=" .. ctx.sends)
        return "done"
    end

    -- Контракт: done / skip / unknown / cancel. Повторы здесь, НЕ в hook.
    playStep = function(step, valid)
        if A.blocked[step.id] then return "skip", "Зависимость пропущена: " .. A.blocked[step.id] end
        local maximum = setting("MoneyAttempts", 5, 1, 20, true)
        local retryDelay = setting("MoneyRetryDelay", 0.5, 0.1, 3)
        local ctx, reason, missing = nil, nil, 0
        while valid() do
            if not ctx then ctx, reason = prepare(step) end
            if ctx then
                -- На границе повтора вновь проверяем поздно пришедшую репликацию.
                if ctx.sends > 0 then
                    local model, err = observed(ctx)
                    if err then return "unknown", err end
                    if model then return finishPurchase(ctx, model, valid) end
                end
                local price, source = livePrice(step)
                if price ~= nil then
                    missing = 0
                    A.runThreshold = price
                    if ctx.folder ~= towers() then return "unknown", "Сменился workspace.Towers" end
                    if step.kind == "Upgrade" and (ctx.target.Parent ~= ctx.folder or level(ctx.target) ~= ctx.oldLevel) then
                        return ctx.sends > 0 and "unknown" or "skip", "Башня/уровень изменились вне текущего шага"
                    end
                    if step.kind == "Target" and ctx.target.Parent ~= ctx.folder then
                        return ctx.sends > 0 and "unknown" or "skip", "Башня изменилась вне текущего шага"
                    end
                    local money = cashNow()
                    if not finite(money) or money < price then
                        phase("WAIT_CASH", "нужно " .. price .. " (" .. source .. ")")
                        task.wait() -- не Wave, не записанный timestamp и не StepDelay
                    else
                        if not valid() then return "cancel", "Остановлено" end
                        ctx.price = price
                        if not A.firstSentAt then
                            A.firstSentAt = os.clock()
                            local _, wave = readWave()
                            A.firstSentWave = wave -- диагностика, НЕ условие отправки
                            trace("FIRST_SEND", "цена=" .. price .. "; после старта " ..
                                string.format("%.3f", A.firstSentAt - A.startedAt) .. " с")
                        end
                        phase("INVOKE", step.kind .. " " .. step.id .. "; " .. (ctx.sends + 1) .. "/" .. maximum)
                        local outcome, detail = sendOnce(ctx, valid)
                        if outcome == "unknown" or outcome == "cancel" then return outcome, detail end
                        phase(outcome == "rejected" and "RETRY_CHECK" or "CONFIRM", "ожидание модели / роста Config.LVL")
                        local model, err = observeFor(ctx,
                            outcome == "rejected" and retryDelay or CONFIRM_TIMEOUT, valid)
                        if not valid() then return "cancel", "Остановлено" end
                        if err then return "unknown", err end
                        if model then return finishPurchase(ctx, model, valid) end
                        if outcome ~= "rejected" then
                            return "unknown", "Ответ получен, но создание/рост LVL не подтверждены; повтор опасен"
                        end
                        trace("REJECTED", step.kind .. " " .. step.id .. "; " .. ctx.sends .. "/" .. maximum)
                        if ctx.sends >= maximum then return "skip", "Лимит явных false: " .. maximum end
                        -- Следующий цикл заново читает ЦЕНУ и Cash; отсутствие денег не тратит попытку.
                    end
                else
                    reason = source
                    missing = missing + 1
                    if missing >= maximum then return "skip", "Данные цены недоступны: " .. tostring(reason) end
                    phase("WAIT_DATA", tostring(reason) .. "; проверка " .. missing .. "/" .. maximum)
                    task.wait(retryDelay)
                end
            else
                missing = missing + 1
                if missing >= maximum then return "skip", "Данные шага недоступны: " .. tostring(reason) end
                phase("WAIT_DATA", tostring(reason) .. "; проверка " .. missing .. "/" .. maximum)
                task.wait(retryDelay)
            end
        end
        return "cancel", "Остановлено"
    end

    hub.Pump = function()
        if not S.alive or not A.alive or not S.playing or S.pumping then return end
        S.pumping = true
        local epoch = S.playEpoch
        local function valid() return S.alive and A.alive and S.playing and S.playEpoch == epoch end
        if A.runEpoch ~= epoch then
            A.runEpoch = epoch
            A.startedAt, A.firstSentAt, A.firstSentWave = os.clock(), nil, nil
            A.lastConfirmedAt, A.runThreshold = nil, nil
            A.blocked, A.skipped, A.completed = {}, 0, 0
            local _, wave = readWave()
            A.startWave = wave
            observeRound(gate, wave, endVisible(), inConfiguredLobby())
            gate.consumed = true
            gate.reason = A.launching and "Автозапуск выполнен" or "Ручное воспроизведение уже запускалось"
            trace("PLAY_START", A.launching and "auto; live money" or "manual; live money")
        end
        task.spawn(function()
            local ok, err = pcall(function()
                while valid() do
                    if endVisible() then stopPlayback("Матч завершён"); return end
                    local step = S.macro.steps[S.cursor]
                    if not step then
                        local summary = "Подтверждено: " .. A.completed .. "; пропущено: " .. A.skipped
                        phase("DONE", summary)
                        stopPlayback("Макрос завершён. " .. summary)
                        return
                    end
                    local outcome, detail = playStep(step, valid)
                    if not valid() then return end
                    if outcome == "done" then
                        A.completed = A.completed + 1
                        A.lastConfirmedAt = os.clock() -- только диагностика, задержка от него НЕ считается
                        S.cursor = S.cursor + 1
                    elseif outcome == "skip" then
                        A.skipped = A.skipped + 1
                        A.blocked[step.id] = A.blocked[step.id] or ("шаг " .. S.cursor .. ": " .. tostring(detail))
                        trace("SKIP", step.kind .. " " .. step.id .. "; " .. tostring(detail))
                        S.cursor = S.cursor + 1
                        -- Не крутим длинную цепочку зависимых пропусков в одном кадре.
                        task.wait()
                    else
                        phase("ERROR", tostring(detail))
                        stopPlayback()
                        problem("money-play", "Шаг " .. S.cursor .. ": " .. tostring(detail))
                        return
                    end
                end
            end)
            S.pumping = false
            if not ok and valid() then
                phase("ERROR", tostring(err))
                stopPlayback()
                problem("money-play", err)
            elseif not valid() and A.phase ~= "DONE" and A.phase ~= "ERROR" then
                phase("STOPPED", "Отправленные запросы не отзываются")
            end
        end)
    end
end
-- КОНЕЦ ЗАМЕНЫ. Следующая исходная строка:
-- local autoParagraph = Tabs.Macro:AddParagraph({ Title = "Автозапуск макроса", Content = "Инициализация" })


    local autoParagraph = Tabs.Macro:AddParagraph({ Title = "Автозапуск макроса", Content = "Инициализация" })
    Tabs.Macro:AddInput("AutoMacroName", { Title = "Файл автозапуска (без .json)", Default = "", Finished = true })
    local pick = Tabs.Macro:AddDropdown("AutoMacroPick", {
        Title = "Выбрать файл автозапуска", Values = {}, Multi = false, AllowNull = true,
    })
    Tabs.Macro:AddToggle("AutoMacroEnabled", { Title = "Автозапуск при загрузке матча", Default = false,
        Description = "Запуск при появлении Stats. Ожидание готовности не расходует попытку. Ошибка файла — без повтора." })
    Tabs.Macro:AddParagraph({ Title = "Автозапуск и первый запрос",
        Content = "PLAY_START означает включение плеера. FIRST_SEND — реальную отправку первого шага. " ..
            "Запрос ждёт порог денег даже при старте по Stats. Одна попытка на показ Stats; " ..
            "повторный показ внутри матча не перезапускает. После телепорта запустите хаб заново." })
    local function syncPick(names)
        A.syncing = true
        local ok, err = pcall(function()
            local name, found = opt("AutoMacroName", ""), false
            for _, candidate in ipairs(names) do if candidate == name then found = true; break end end
            pick:SetValues(names)
            pick:SetValue(found and name or nil)
            pick:Display()
        end)
        A.syncing = false
        if not ok then error(err) end
    end
    local originalRefresh = refreshMacros
    refreshMacros = function(preferred)
        local names = originalRefresh(preferred)
        syncPick(names)
        return names
    end
    pick:OnChanged(function(name)
        if not A.syncing and safeName(name) then options.AutoMacroName:SetValue(name) end
    end)
    options.AutoMacroName:OnChanged(function()
        if not A.syncing then action(refreshMacros)() end
    end)
    action(refreshMacros)()

    -- Синхронная загрузка Fluent; AutoMacroEnabled применяется последним.
    if managersReady and SaveManager then
        SaveManager:SetIgnoreIndexes({ "AutoMacroPick" })
        function SaveManager:Load(name)
            if not safeName(name) then return false, "Недопустимое имя конфига" end
            if A.loading or A.launching then return false, "Загрузка уже выполняется" end
            if S.recording or S.playing or S.pumping or S.pending > 0 or S.drainScheduled or next(S.locks) then
                return false, "Остановите запись/макрос и дождитесь запросов"
            end
            A.loading, A.configFailed = true, true
            local good, err = pcall(function()
                local path = self.Folder .. "/settings/" .. name .. ".json"
                assert(isfile(path), "Файл конфига отсутствует")
                local text = readfile(path)
                assert(#text <= LIMIT.Bytes, "Конфиг слишком большой")
                local data = Http:JSONDecode(text)
                assert(type(data) == "table", "Повреждён конфиг")
                array(data.objects, 512)
                local autoName, autoEnabled, seen = "", false, {}
                for _, entry in ipairs(data.objects) do
                    assert(type(entry) == "table" and type(entry.idx) == "string"
                        and type(entry.type) == "string", "Повреждён элемент конфига")
                    assert(not seen[entry.idx], "Дублирующаяся настройка: " .. entry.idx)
                    seen[entry.idx] = true
                    if entry.idx == "AutoMacroName" then
                        assert(entry.type == "Input" and type(entry.text) == "string"
                            and (entry.text == "" or safeName(entry.text)), "Неверное имя автомакроса")
                        autoName = entry.text
                    elseif entry.idx == "AutoMacroEnabled" then
                        assert(entry.type == "Toggle" and type(entry.value) == "boolean", "Неверный флаг автомакроса")
                        autoEnabled = entry.value
                    elseif entry.idx == "StepDelay" or entry.idx == "CashSyncTimeout" then
                        local value = tonumber(entry.value)
                        local low = entry.idx == "StepDelay" and 0 or 0.25
                        local high = entry.idx == "StepDelay" and 2 or 8
                        assert(entry.type == "Slider" and finite(value) and value >= low and value <= high,
                            "Неверный интервал: " .. entry.idx)
                    end
                    if self.Options[entry.idx] and not self.Ignore[entry.idx] then
                        assert(self.Options[entry.idx].Type == entry.type, "Тип настройки не совпадает: " .. entry.idx)
                    end
                end
                options.AutoMacroEnabled:SetValue(false)
                options.StepDelay:SetValue(0.25)
                options.CashSyncTimeout:SetValue(2)
                for _, entry in ipairs(data.objects) do
                    if entry.idx ~= "AutoMacroName" and entry.idx ~= "AutoMacroEnabled"
                        and not self.Ignore[entry.idx] then
                        local parser = self.Parser[entry.type]
                        if parser and self.Options[entry.idx] then parser.Load(entry.idx, entry) end
                    end
                end
                options.AutoMacroName:SetValue(autoName)
                refreshMacros()
                options.AutoMacroEnabled:SetValue(autoEnabled)
            end)
            A.loading, A.configFailed = false, not good
            if not good then
                pcall(function() options.AutoMacroEnabled:SetValue(false) end)
                A.status = "Ошибка конфига; автозапуск заблокирован"
                return false, tostring(err)
            end
            return true
        end
        -- Upstream LoadAutoloadConfig не возвращает ошибку self:Load вызывающему.
        -- Здесь сохраняем состояние ошибки для барьера запуска.
        function SaveManager:LoadAutoloadConfig()
