            end
            local url, id = endpoint(opt("WebhookURL", ""))
            if not url then status(id); return end
            local fn, driver = chooseHTTP(opt("WebhookHTTP", "Авто"))
            if not fn then status(driver); return end
            local body = '{"allowed_mentions":{"parse":[]},"content":'
                .. Http:JSONEncode("Slop TD Hub: тест HTTP API. Это не результат матча.") .. '}'
            local ticket, err = send(body, url, id, fn, driver)
            if not ticket then status(err); return end
            W.testTicket = ticket
            status("Тестовый запрос отправлен через " .. driver)
        end)
    end)

    local function observe(frame, late)
        if P.result or not visible(frame) then return end
        -- Таймер снимается даже до готовности конфига; конфигурация отправки читается позже.
        P.result = { seenAt = os.clock(), seconds = sessionSeconds(), late = late == true,
            attempted = false, finished = false, message = "Сбор наград" }
    end
    local function process(frame)
        local r = P.result
        if not r then return false end
        if r.ticket then
            if tickTicket(r.ticket) then finish(r, r.ticket.message) end
        end
        if r.finished then status(r.message); return false end
        if not W.ready or W.loading then return true end
        if not r.configured then
            r.configured = true
            local wait = tonumber(opt("WebhookEndWait", 20))
            if not finite(wait) then wait = 20 end
            r.releaseAt = r.seenAt + math.clamp(wait, 5, 30)
            if not opt("WebhookEnabled", false) then finish(r, "Webhook выключен: результат пропущен"); return false end
            local url, id = endpoint(opt("WebhookURL", ""))
            if not url then finish(r, id); return false end
            local fn, driver = chooseHTTP(opt("WebhookHTTP", "Авто"))
            if not fn then finish(r, driver); return false end
            r.url, r.webhookId, r.fn, r.driver = url, id, fn, driver
        end
        if not opt("WebhookEnabled", false) then
            finish(r, r.attempted and "Webhook выключен; отправленный запрос не отменён" or "Webhook выключен: отправка отменена")
            return false
        end
        local now = os.clock()
        if now >= r.releaseAt then
            finish(r, r.attempted and "Предел ожидания выхода; исход HTTP неизвестен, повтора нет"
                or "Предел ожидания выхода; webhook не отправлен")
            return false
        end
        if r.attempted then status("Ожидание ответа Discord"); return true end
        if not visible(frame) then finish(r, "EndScreen исчез до снимка; webhook не отправлен"); return false end
        if now - r.seenAt >= CAPTURE_TIMEOUT then
            finish(r, "Награды не готовы: " .. (r.lastReason or "истёк срок стабилизации"))
            return false
        end
        local snapshot, reason = readResult(frame)
        if not snapshot then
            r.signature, r.changedAt, r.lastReason = nil, nil, reason
            status(reason)
            return true
        end
        if r.signature ~= snapshot.signature then r.signature, r.changedAt = snapshot.signature, now end
        if not stableEnough(r, now) then status("Ожидание стабильных наград"); return true end
        local body, err = makeBody(snapshot, r)
        if not body then finish(r, err); return false end
        if P.pending or now < P.nextHTTP then status("Ожидание HTTP API / ограничения Discord"); return true end
        local ticket, sendError = send(body, r.url, r.webhookId, r.fn, r.driver, r)
        r.url, r.fn = nil, nil
        if not ticket then finish(r, sendError); return false end
        status("Результат отправлен; ожидается подтверждение Discord")
        return true
    end

    -- Одна точка входа: существующий safeCycle("end", endCycle) теперь сначала обрабатывает webhook.
    -- Старый endCycle с приоритетом AutoLeave сохранён и вызывается только после барьера.
    local originalEndCycle = endCycle
    endCycle = function()
        if not W.alive then return originalEndCycle() end
        local frame = endingFrame()
        observe(frame, false)
        if visible(frame) then
            if S.playing then stopPlayback("Матч завершён; макрос остановлен") end
            if S.recording then S.recording = false; notify("Матч завершён; запись остановлена") end
        end
        if W.testTicket then
            if tickTicket(W.testTicket) then status(W.testTicket.message); W.testTicket = nil end
        end
        local ok, hold = pcall(process, frame)
        if not ok then
            -- Не выводим текст исключения, потенциально содержащий URL.
            if P.result then finish(P.result, "Ошибка модуля webhook; отправка не повторяется") end
            hold = false
        end
        if not W.ready or W.loading or hold then return end
        return originalEndCycle()
    end

    -- Более ранний снимок таймера по Visible; полное effective-проверяется observe().
    local function attach(frame)
        if frame == W.frame then return end
        if W.connection then W.connection:Disconnect(); W.connection = nil end
        W.frame = frame
        if frame and frame:IsA("GuiObject") then
            W.connection = frame:GetPropertyChangedSignal("Visible"):Connect(function()
                if W.alive and S.alive then observe(frame, false) end
            end)
        end
    end
    attach(endingFrame())
    observe(endingFrame(), true)
    local baseCycle = endCycle
    endCycle = function()
        attach(endingFrame())
        return baseCycle()
    end

    -- Существующий synchronous Load из автомакроса сохраняется. Webhook при загрузке не работает.
    if managersReady and SaveManager then
        local originalLoad = SaveManager.Load
        function SaveManager:Load(name)
            if W.loading or not safeName(name) then return false, "Недопустимое имя / конфиг загружается" end
            if S.recording or S.playing or S.pumping or S.pending > 0 or S.drainScheduled or next(S.locks)
                or (W.ready and P.result and not P.result.finished) then
                return false, "Дождитесь остановки операций и обработки результата"
            end
            W.loading = true
            local ok, loaded, detail = pcall(function()
                -- Старые конфиги без Webhook-полей не наследуют URL/Enabled от предыдущего.
                options.WebhookEnabled:SetValue(false)
                options.WebhookURL:SetValue("")
                options.WebhookHTTP:SetValue("Авто")
                options.WebhookEndWait:SetValue(20)
                return originalLoad(self, name)
            end)
            if not ok or not loaded then
                pcall(function() options.WebhookEnabled:SetValue(false) end)
            end
            W.loading = false
            if not ok then return false, "Ошибка загрузки конфига; webhook выключен" end
            return loaded, detail
        end
    end
    local originalStartup = hub.CompleteAutoMacroStartup
    hub.CompleteAutoMacroStartup = function(...)
        local results = table.pack(originalStartup(...))
        W.ready = true
        status("Готов. Тест HTTP API ещё не выполнялся этим модулем.")
        return table.unpack(results, 1, results.n)
    end
    local originalDestroy = hub.Destroy
    hub.Destroy = function(...)
        W.alive = false
        if W.connection then W.connection:Disconnect(); W.connection = nil end
        if P.result and not P.result.attempted and not P.result.finished then
            P.result.finished, P.result.message = true, "Хаб выгружен до отправки; результат пропущен"
        end
        -- P и ticket сохраняются: запрос мог уже попасть в Discord. Его нельзя повторять.
        return originalDestroy(...)
    end
end

do
    -- Конфиги по аккаунтам: отдельная папка настроек Fluent на каждый UserId.
    -- Общая папка сохраняется для совместимости; тема и макросы остаются общими.
    if hub.CPA then return end
    local CPA = { alive = true, perAccount = false }
    hub.CPA = CPA

    if not fileOK or not managersReady or not SaveManager then
        Tabs.Configs:AddParagraph({ Title = "Конфиги по аккаунтам", Content =
            "Недоступно: нужны файловые функции и менеджер конфигов." })
        return
    end

    -- Путь к глобальному флагу режима; сам флаг общий для всех аккаунтов.
    local function modePath() return ROOT .. "/cpa_mode.txt" end
    -- Общая папка конфигов (старое поведение).
    local function globalFolder() return ROOT .. "/configs" end
    -- Папка текущего аккаунта; только UserId, ник может содержать небезопасные символы.
    local function accountFolder() return ROOT .. "/configs/accounts/" .. tostring(LP.UserId) end

    -- Читаем сохранённый режим; при отсутствии файла остаёмся в общем режиме.
    do
        local ok, stored = pcall(function()
            if isfile(modePath()) then return readfile(modePath()) end
            return nil
        end)
        if ok and type(stored) == "string" then
            local t = stored:match("^%s*(.-)%s*$"):lower()
            CPA.perAccount = (t == "1" or t == "true" or t == "peraccount" or t == "per-account")
        end
    end

    local cpaStatus = Tabs.Configs:AddParagraph({ Title = "Конфиги по аккаунтам", Content = "Инициализация" })
    local cpaToggle = Tabs.Configs:AddToggle("CPA_PerAccount", {
        Title = "Конфиги отдельно для каждого аккаунта",
        Description = "Вкл: папка accounts/<UserId>. Выкл: общая папка configs. Список ниже обновляется сам.",
        Default = CPA.perAccount,
    })
    -- Зеркало списка файлов настройкой не является; сам переключатель тоже не сохраняем в конфиг.
    SaveManager:SetIgnoreIndexes({ "CPA_PerAccount" })

    -- Текущий автозагрузочный конфиг именно из активной папки.
    local function describeAutoload()
        local ok, text = pcall(function()
            local path = SaveManager.Folder .. "/settings/autoload.txt"
            if isfile(path) then return readfile(path) end
            return nil
        end)
        if not ok or type(text) ~= "string" then return "нет" end
        text = text:match("^%s*(.-)%s*$")
        return text ~= "" and text or "нет"
    end

    -- Обновляет статусный параграф; ошибок наружу не бросает.
    local function updateStatus()
        local ok, names = pcall(function() return SaveManager:RefreshConfigList() end)
        local count = (ok and type(names) == "table") and #names or 0
        local text = "Аккаунт: " .. tostring(LP.Name) .. " (" .. tostring(LP.UserId) .. ")"
            .. "\nРежим: " .. (CPA.perAccount and "по аккаунтам" or "общий")
            .. "\nПапка: " .. tostring(SaveManager.Folder)
            .. "\nКонфигов: " .. tostring(count)
            .. "\nАвтозагрузка: " .. describeAutoload()
        pcall(function() cpaStatus:SetDesc(text) end)
    end

    -- Ядро: выставить правильную папку и освежить список дропдауна.
    function CPA.applySilent()
        local folder = CPA.perAccount and accountFolder() or globalFolder()
        ensureFolder(folder .. "/settings")
        SaveManager:SetFolder(folder)
        pcall(function()
            local names = SaveManager:RefreshConfigList()
            local dd = SaveManager.Options and SaveManager.Options.SaveManager_ConfigList
            if dd then
                dd:SetValues(names)
                dd:SetValue(nil)
            end
        end)
        updateStatus()
    end

    cpaToggle:OnChanged(function(value)
        if not CPA.alive or not S.alive then return end
        local ok, err = pcall(function()
            CPA.perAccount = (value == true)
            ensureFolder(ROOT)
            writefile(modePath(), CPA.perAccount and "1" or "0")
            CPA.applySilent()
        end)
        if not ok then
            problem("cpa", err)
        else
            notify(CPA.perAccount and "Режим: конфиги по аккаунтам" or "Режим: общие конфиги")
        end
    end)

    button(Tabs.Configs, "Обновить список конфигов (папка аккаунта)", function()
        CPA.applySilent()
    end, "Перечитывает активную папку и обновляет Config list.")

    -- Обёртки поверх существующих Load/Save: сначала правильная папка, потом оригинал.
    local origSave = SaveManager.Save
    function SaveManager:Save(name)
        if CPA.alive and S.alive then pcall(function() CPA.applySilent() end) end
        return origSave(self, name)
    end
    local origLoad = SaveManager.Load
    function SaveManager:Load(name)
        if CPA.alive and S.alive then pcall(function() CPA.applySilent() end) end
        return origLoad(self, name)
    end
    local origAutoload = SaveManager.LoadAutoloadConfig
    function SaveManager:LoadAutoloadConfig()
        if CPA.alive and S.alive then pcall(function() CPA.applySilent() end) end
        return origAutoload(self)
    end

    local origDestroy = hub.Destroy
    hub.Destroy = function(...)
        CPA.alive = false
        return origDestroy(...)
    end

    -- Стартовое применение до LoadAutoloadConfig в секции запуска.
    pcall(function() CPA.applySilent() end)
end

do
    -- Командный автозапуск: заход в лифт только полной командой, старт не нажимаем.
    -- Survival-команда всегда Elevator7, Raid-команда всегда Elevator1.
    if hub.Team then return end
    local T = { alive = true, lastPoll = -math.huge, lastEnter = -math.huge,
        lastStage = -math.huge, matchSince = nil, lastKick = -math.huge, status = "Инициализация" }
    hub.Team = T

    -- Аддитивные данные лифта из сообщения пользователя, литералы выше не трогаем.
    if ELEVATOR_POS.Elevator7 == nil then
        ELEVATOR_POS.Elevator7 = Vector3.new(59, 61, 113)
    end
    do
        local has7 = false
        for _, n in ipairs(ELEVATORS) do if n == "Elevator7" then has7 = true; break end end
        if not has7 then ELEVATORS[#ELEVATORS + 1] = "Elevator7" end
    end

    -- Разбор имён через запятую/пробел/точку с запятой.
    local function splitNames(s)
        local out = {}
        if type(s) ~= "string" then return out end
        for tok in s:gsub("[,;]+", " "):gmatch("%S+") do out[#out + 1] = tok end
        return out
    end
    -- Ник Roblox: латиница/цифры/подчёркивание, 3-20 символов.
    local function validName(n)
        return type(n) == "string" and #n >= 3 and #n <= 20 and n:match("^[%w_]+$") ~= nil
    end
    -- Вайтлист без самого себя (регистр не важен), дубликаты убираются.
    local function whitelist()
        local seen, out, bad = {}, {}, 0
        for _, tok in ipairs(splitNames(opt("TeamWhitelist", ""))) do
            if validName(tok) then
                local k = tok:lower()
                if k ~= LP.Name:lower() and not seen[k] then seen[k] = true; out[#out + 1] = tok end
            else bad = bad + 1 end
        end
        return out, bad
    end
    -- Карта игроков сервера по нижнему регистру имени.
    local function playersByName()
        local map = {}
        local ok, list = pcall(function() return Players:GetPlayers() end)
        if ok and type(list) == "table" then
            for _, p in ipairs(list) do
                if typeof(p) == "Instance" and p:IsA("Player") then map[p.Name:lower()] = p end
            end
        end
        return map
    end
    -- Позиция персонажа без исключений наружу.
    local function charPos(player)
        local ok, pos = pcall(function()
            local ch = player and player.Character
            if not ch then return nil end
            local hrp = ch:FindFirstChild("HumanoidRootPart")
            if hrp and hrp:IsA("BasePart") then return hrp.Position end
            return ch:GetPivot().Position
        end)
        return ok and pos or nil
    end
    local function selfHrp()
        local ch = LP.Character
        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
        return (hrp and hrp:IsA("BasePart")) and hrp or nil
    end
    -- Центр зоны из строки "x, y, z"; при мусоре возвращается зона по умолчанию.
    local function parseZone()
        local raw = opt("TeamZone", "68.5, 62.3, 87.6")
        if type(raw) == "string" then
            local nums = {}
            for n in raw:gmatch("[-+]?%d+%.?%d*") do nums[#nums + 1] = tonumber(n) end
            if #nums >= 3 and finite(nums[1]) and finite(nums[2]) and finite(nums[3]) then
                return Vector3.new(nums[1], nums[2], nums[3])
            end
        end
        return Vector3.new(68.5, 62.3, 87.6)
    end
    local function numOpt(id, fallback, low, high)
        local v = tonumber(opt(id, fallback))
        if not finite(v) then v = fallback end
        return math.clamp(v, low, high)
    end

    local teamStatus = Tabs.Lobby:AddParagraph({ Title = "Командный автозапуск", Content = "Инициализация" })
    Tabs.Lobby:AddToggle("TeamEnabled", { Title = "Командный автозапуск (по вайтлисту)", Default = false,
        Description = "В лобби ждёт союзников и зону, заходит в командный лифт без Start. В матче кикает при неполной команде." })
    Tabs.Lobby:AddInput("TeamWhitelist", { Title = "Союзники (имена через запятую)", Finished = true,
        Default = "fewit1i032, cepit6J729, cepit1b713, cepitb0494" })
    Tabs.Lobby:AddInput("TeamAdd", { Title = "Добавить / убрать имя", Default = "", Finished = true,
        Description = "Вспомогательное поле, в конфиг не сохраняется." })
    Tabs.Lobby:AddSlider("TeamPoll", { Title = "Опрос готовности, секунд", Default = 3, Min = 1, Max = 10, Rounding = 0 })
    Tabs.Lobby:AddSlider("TeamGrace", { Title = "Грейс в матче до кика, секунд", Default = 20, Min = 5, Max = 60, Rounding = 0 })
    Tabs.Lobby:AddToggle("TeamUseZone", { Title = "Требовать общую зону перед лифтом", Default = true,
        Description = "Выкл — ждём только загрузку персонажей союзников." })
    Tabs.Lobby:AddInput("TeamZone", { Title = "Центр зоны (x, y, z)", Default = "68.5, 62.3, 87.6", Finished = true })
    Tabs.Lobby:AddSlider("TeamZoneR", { Title = "Радиус зоны", Default = 7, Min = 3, Max = 30, Rounding = 0 })
    if managersReady and SaveManager then
        SaveManager:SetIgnoreIndexes({ "TeamAdd" })
    end

    local function setStatus(text)
        T.status = text
        pcall(function() teamStatus:SetDesc(text) end)
    end

    button(Tabs.Lobby, "Добавить имя в вайтлист", function()
        local cur = splitNames(opt("TeamWhitelist", ""))
        local have = {}
        for _, n in ipairs(cur) do have[n:lower()] = true end
        for _, tok in ipairs(splitNames(opt("TeamAdd", ""))) do
            assert(validName(tok), "Некорректное имя: " .. tostring(tok))
            if tok:lower() ~= LP.Name:lower() and not have[tok:lower()] then
                have[tok:lower()] = true; cur[#cur + 1] = tok
            end
        end
        options.TeamWhitelist:SetValue(table.concat(cur, ", "))
        options.TeamAdd:SetValue("")
        notify("Вайтлист обновлён")
    end)
    button(Tabs.Lobby, "Убрать имя из вайтлиста", function()
        local drop = {}
        for _, tok in ipairs(splitNames(opt("TeamAdd", ""))) do drop[tok:lower()] = true end
        local cur = {}
        for _, n in ipairs(splitNames(opt("TeamWhitelist", ""))) do
            if not drop[n:lower()] then cur[#cur + 1] = n end
        end
        options.TeamWhitelist:SetValue(table.concat(cur, ", "))
        options.TeamAdd:SetValue("")
        notify("Вайтлист обновлён")
    end)
    button(Tabs.Lobby, "Очистить вайтлист", function()
        options.TeamWhitelist:SetValue("")
        options.TeamAdd:SetValue("")
        notify("Вайтлист очищен")
    end)

    -- Лобби: ждём сервер, зону/загрузку, затем телепорт и Enter без Start.
    local function lobbyPhase(now)
        local allies, bad = whitelist()
        if #allies == 0 then setStatus("Вайтлист пуст (без себя)" .. (bad > 0 and "; мусорных: " .. bad or "")); return end
        local byName = playersByName()
        local missing = {}
        for _, n in ipairs(allies) do if not byName[n:lower()] then missing[#missing + 1] = n end end
        if #missing > 0 then
            setStatus("Ждём на сервере " .. (#allies - #missing) .. "/" .. #allies .. ": " .. table.concat(missing, ", "))
            return
        end
        if S.recording or S.playing then setStatus("Пауза: идёт запись/макрос"); return end
        local hrp = selfHrp()
        if not hrp then setStatus("Ждём загрузку своего персонажа"); return end
        local elev = (opt("LobbyMode", "Survival") == "Raid") and "Elevator1" or "Elevator7"
        local epos = ELEVATOR_POS[elev]
        if not epos then setStatus("Нет координат лифта " .. elev); return end
        -- Уже у лифта и недавно заходили: не спамим, ждём автостарт 10 с.
        if (hrp.Position - epos).Magnitude < 12 and now - T.lastEnter < 15 then
            setStatus("В лифте " .. elev .. ", ждём автостарт; союзники на сервере: " .. #allies .. "/" .. #allies)
            return
        end
                -- Союзник готов, если в зоне или уже у целевого лифта (иначе staggered-входы встанут).
        local function allyReady(name, byName, center, r, epos)
            local pos = charPos(byName[name:lower()])
            if not pos then return false end
            if (pos - center).Magnitude <= r then return true end
            return (pos - epos).Magnitude < 12
        end
        -- Физический вход: телепорт, шаги в радиусе 3 для репликации, затем Enter. Без Start.
        local function beginEnter(elev, epos)
            if T.entering then return end
            T.entering = true
            task.spawn(function()
                local ok, err = pcall(function()
                    if not (T.alive and S.alive) then return end
                    local hrp0 = selfHrp()
                    if not hrp0 then return end
                    hrp0.CFrame = CFrame.new(epos)
                    -- Шаги с амплитудой не более 3 от координат лифта.
                    local steps = { Vector3.new(2, 0, 0), Vector3.new(-2, 0, 1.5),
                        Vector3.new(1, 0, -2), Vector3.new(0, 0, 0) }
                    for _, off in ipairs(steps) do
                        if not (T.alive and S.alive) then return end
                        local hrp = selfHrp()
                        if not hrp then return end
                        hrp.CFrame = CFrame.new(epos + off)
                        task.wait(0.12)
                    end
                    if not (T.alive and S.alive) then return end
                    local okFire, msg = fire("Events", "EnterElevator", elev)
                    if not okFire then problem("team-enter", msg or elev); return end
                    T.lastEnter = os.clock()
                end)
                T.entering = false
                if not ok and T.alive and S.alive then problem("team", err) end
            end)
        end
        local poll = numOpt("TeamPoll", 0.6, 0.5, 10)
        local delay = numOpt("TeamEnterDelay", 5, 0, 15)
        if opt("TeamUseZone", true) then
            local center, r = parseZone(), numOpt("TeamZoneR", 7, 3, 30)
            local selfIn = (hrp.Position - center).Magnitude <= r
                or (hrp.Position - epos).Magnitude < 12
            -- Себя всегда сначала стягиваем в зону, даже если союзники уже там.
            if not selfIn then
                T.readySince = nil
                if now - T.lastStage >= poll then
                    T.lastStage = now
                    hrp.CFrame = CFrame.new(center)
                end
                setStatus("Идём в зону, затем общий таймер")
                return
            end
            local outside = {}
            for _, n in ipairs(allies) do
                if not allyReady(n, byName, center, r, epos) then outside[#outside + 1] = n end
            end
            if #outside > 0 then
                T.readySince = nil
                setStatus("Зона: вне её " .. #outside .. "/" .. #allies .. ": " .. table.concat(outside, ", "))
                return
            end
        else
            for _, n in ipairs(allies) do
                if not charPos(byName[n:lower()]) then
                    T.readySince = nil
                    setStatus("Ждём загрузку персонажа: " .. n); return
                end
            end
        end
        -- Все готовы: общий таймер для всех, затем один вход через воркер.
        if delay <= 0 then
            T.readySince = nil
            if not T.entering then beginEnter(elev, epos) end
            setStatus("Готовы, входим в " .. elev .. "; Start не нажимаем")
            return
        end
        if not T.readySince then T.readySince = now end
        local left = math.max(0, math.ceil(T.readySince + delay - now))
        if left > 0 then
            setStatus("Готовы " .. #allies .. "/" .. #allies .. "; вход через " .. left .. " с")
            return
        end
        T.readySince = nil
        if not T.entering then beginEnter(elev, epos) end
        setStatus("Зашли в " .. elev .. "; автостарт ~10 с, Start не нажимаем")
    end

    -- Матч: грейс на появление всех, иначе кик для перезахода через Reconnect.
    local function matchPhase(now)
        local allies = whitelist()
        if #allies == 0 then return end
        if not T.matchSince then T.matchSince = now end
        local byName = playersByName()
        local missing = {}
        for _, n in ipairs(allies) do if not byName[n:lower()] then missing[#missing + 1] = n end end
        if #missing == 0 then setStatus("Матч: команда в сборе"); return end
        local grace = numOpt("TeamGrace", 20, 5, 60)
        local left = math.max(0, math.ceil(T.matchSince + grace - now))
        if left > 0 then
            setStatus("Матч: нет союзников: " .. table.concat(missing, ", ") .. "; кик через " .. left .. " с")
            return
        end
        if now - T.lastKick < 60 then setStatus("Кик уже выполнялся, ждём"); return end
        T.lastKick = now
        if S.playing then stopPlayback("Неполная команда") end
        S.recording = false
        problem("team-kick", "Нет союзников: " .. table.concat(missing, ", "))
        pcall(function() LP:Kick("не обнаружен союзник") end)
    end

    local function teamTick()
        if not T.alive or not S.alive or not opt("TeamEnabled", false) then return end
        local now = os.clock()
        if now - T.lastPoll < numOpt("TeamPoll", 3, 1, 10) then return end
        T.lastPoll = now
        local ok, err = pcall(function()
            if inConfiguredLobby() then
                T.matchSince, T.lastKick = nil, -math.huge
                lobbyPhase(now)
            else
                matchPhase(now)
            end
        end)
        if not ok then problem("team", err) end
    end

    -- Ветвление вместо правки главного цикла: команда перехватывает elevator-слот.
    local origElevator = elevatorCycle
    elevatorCycle = function()
        if T.alive and S.alive and opt("TeamEnabled", false) then teamTick(); return end
        return origElevator()
    end

    if managersReady and SaveManager then
        local origLoad = SaveManager.Load
        function SaveManager:Load(name)
            local res = table.pack(origLoad(self, name))
            if not res[1] then pcall(function() options.TeamEnabled:SetValue(false) end) end
            return table.unpack(res, 1, res.n)
        end
    end

    local origDestroy = hub.Destroy
    hub.Destroy = function(...)
        T.alive = false
        return origDestroy(...)
    end
    pcall(function() setStatus("Готов. Вайтлист задаётся в TeamWhitelist") end)
end
do
    -- Autoskip: голос за пропуск при видимом WaveSkipGui; фильтр — только числа.
    if hub.Skip then return end
    local SK = { alive = true, lastVote = -math.huge, sentWave = nil, shown = nil }
    hub.Skip = SK

    -- Номер текущей волны из надписи "Wave: X/Y"; nil при нечитаемой надписи.
    local function parseWave()
        local ok, n = pcall(function()
            local gui = gameGui()
            local info = gui and gui:FindFirstChild("Info")
            local stats = info and info:FindFirstChild("Stats")
            local label = stats and stats:FindFirstChild("Wave")
            local text = (label and label:IsA("TextLabel")) and label.Text or nil
            if type(text) ~= "string" then return nil end
            local v = tonumber(text:match("Wave:%s*(%d+)"))
            if v and v % 1 == 0 and v >= 1 and v <= 9999 then return v end
            return nil
        end)
        return ok and n or nil
    end
    -- Список волн-исключений: только числа через запятую/пробел; мусор игнорируется.
    local function parseSkipList()
        local set, bad, n = {}, 0, 0
        local raw = tostring(opt("SkipWaves", ""))
        for tok in raw:gsub("[,;]+", " "):gmatch("%S+") do
            local v = tonumber(tok)
            if v and v % 1 == 0 and v >= 1 and v <= 9999 and n < 500 then
                if not set[v] then set[v] = true; n = n + 1 end
            else bad = bad + 1 end
        end
        return set, bad
    end

    local skipStatus = Tabs.Main:AddParagraph({ Title = "Autoskip", Content = "Инициализация" })
    Tabs.Main:AddToggle("AutoSkip", { Title = "Auto Skip Wave", Default = false,
        Description = "Голосовать за пропуск при появлении меню WaveSkipGui." })
    Tabs.Main:AddToggle("SkipFilter", { Title = "Фильтр волн", Default = false,
        Description = "Вкл: волны из списка ниже не пропускать." })
    Tabs.Main:AddInput("SkipWaves", { Title = "Волны-исключения (числа через запятую)", Default = "", Finished = true })
    local function setStatus(text)
        if SK.shown ~= text then SK.shown = text end
        pcall(function() if SK.shown == text then skipStatus:SetDesc(text) end end)
    end

    worker("skip", function()
        while SK.alive and S.alive and not Fluent.Unloaded do
            local ok, err = pcall(function()
                if not opt("AutoSkip", false) then setStatus("Выключен"); return end
                local gui = gameGui()
                local frame = gui and gui:FindFirstChild("WaveSkipGui")
                if not visible(frame) then SK.sentWave = nil; setStatus("Ожидание меню пропуска"); return end
                local wave = parseWave()
                if opt("SkipFilter", false) then
                    local set, bad = parseSkipList()
                    if not wave then setStatus("Волна не прочитана — пропуск"); return end
                    if set[wave] then
                        SK.sentWave = wave
                        setStatus("Волна " .. wave .. " в исключениях" .. (bad > 0 and ("; мусорных: " .. bad) or ""))
                        return
                    end
                end
                if SK.sentWave == wave or os.clock() - SK.lastVote < 2 then return end
                local r = remote("Functions", "VoteSkip", "RemoteFunction")
                if not r then problem("skip", "Нет Functions.VoteSkip"); return end
                local res, callErr = invoke("skip", r, table.pack(),
                    function() return S.alive and SK.alive and opt("AutoSkip", false) end)
                SK.lastVote = os.clock()
                if res then SK.sentWave = wave; setStatus("Пропуск волны: " .. tostring(wave))
                else problem("skip", callErr) end
            end)
            if not ok and SK.alive and S.alive then problem("skip", err) end
            task.wait(0.5)
        end
    end)

    local origDestroy = hub.Destroy
    hub.Destroy = function(...)
        SK.alive = false
        if hub.NewMap then hub.NewMap.alive = false end
        return origDestroy(...)
    end
    pcall(function() setStatus("Готов") end)
end
do
    -- Auto New map: решение отправляется веткой New внутри endCycle; здесь только переключатель.
    if hub.NewMap then return end
    hub.NewMap = { alive = true }
    Tabs.Lobby:AddParagraph({ Title = "Auto New map", Content =
        "EndDecision(\"new\"). Приоритет: Leave > New map > Replay. Вебхук-барьер держит решение." })
    Tabs.Lobby:AddToggle("AutoNewMap", { Title = "Auto New map / EndScreen", Default = false,
        Description = "EndDecision(\"new\"). Приоритет: Leave > New map > Replay." })
end
do
    -- AutoMutator: голос за первый по приоритету Id из списка; совпадений нет — None.
    if hub.Mutator then return end
    local MU = { alive = true, votedId = nil }
    hub.Mutator = MU

    -- Разбор списка приоритетов: порядок = приоритет, первый — главный.
    local function parsePriority()
        local out, seen, bad = {}, {}, 0
        local raw = tostring(opt("MutatorList", ""))
        for tok in raw:gsub("[,;]+", " "):gmatch("%S+") do
            if #tok >= 1 and #tok <= 64 and tok:match("^[%w_]+$") and #out < 32 then
                if not seen[tok] then seen[tok] = true; out[#out + 1] = tok end
            else bad = bad + 1 end
        end
        return out, bad
    end
    -- Предложенные Id: имена GuiObject-детей MutatorVoting, кроме UIListLayout.
    local function offeredIds(frame)
        local set, list = {}, {}
        local ok = pcall(function()
            for _, child in ipairs(frame:GetChildren()) do
                if child:IsA("GuiObject") and child.Name ~= "UIListLayout" then
                    if not set[child.Name] then set[child.Name] = true; list[#list + 1] = child.Name end
                end
            end
        end)
        if not ok then return nil end
        return set, list
    end

    local mutStatus = Tabs.Main:AddParagraph({ Title = "AutoMutator", Content = "Инициализация" })
    Tabs.Main:AddToggle("AutoMutator", { Title = "Auto Vote Mutator", Default = false,
        Description = "Голосовать за первый по приоритету мутатор из списка." })
    Tabs.Main:AddInput("MutatorList", { Title = "Мутаторы по приоритету (через запятую)", Finished = true,
        Default = "BossRush, Speedrun, TinySlop, Regeneration, Blackout, Brainrot, Gigantism, None" })
    local function setStatus(text) pcall(function() mutStatus:SetDesc(text) end) end

    -- Наблюдатель итога голосования для статуса (тирдаун через connect).
    pcall(function()
        local folder = RS:FindFirstChild("Events")
        local r = folder and folder:FindFirstChild("SlopMutator")
        if r and r:IsA("RemoteEvent") then
            connect(r.OnClientEvent, function(kind, data)
                if not MU.alive or not S.alive or kind ~= "Active" then return end
                if type(data) == "table" and type(data.Id) == "string" then
                    setStatus("Активен мутатор: " .. data.Id)
                end
            end)
        end
    end)

    worker("mutator", function()
        while MU.alive and S.alive and not Fluent.Unloaded do
            local ok, err = pcall(function()
                if not opt("AutoMutator", false) then setStatus("Выключен"); return end
                local pg = LP:FindFirstChildOfClass("PlayerGui")
                local gui = pg and pg:FindFirstChild("SlopMutatorGui")
                local frame = gui and gui:FindFirstChild("MutatorVoting")
                if not visible(frame) then MU.votedId = nil; setStatus("Ожидание голосования"); return end
                if MU.votedId then return end
                local set, list = offeredIds(frame)
                if not set then setStatus("Не прочитаны варианты"); return end
                local priority, bad = parsePriority()
                local pick
                for _, id in ipairs(priority) do if set[id] then pick = id; break end end
                if not pick then
                    if set.None then pick = "None" else setStatus("Своих нет, None нет"); return end
                end
                -- Одна попытка на показ: помечаем до отправки.
                MU.votedId = pick
                local sent, msg = fire("Events", "SlopMutator", "Vote", pick)
                if not sent then
                    MU.votedId = nil
                    problem("mutator", msg or pick)
                else
                    setStatus("Голос: " .. pick .. " (" .. #list .. " вариантов)"
                        .. (bad > 0 and ("; мусорных: " .. bad) or ""))
                end
            end)
            if not ok and MU.alive and S.alive then problem("mutator", err) end
            task.wait(0.5)
        end
    end)

    local origDestroy = hub.Destroy
    hub.Destroy = function(...)
        MU.alive = false
        return origDestroy(...)
    end
    pcall(function() setStatus("Готов") end)
end
-- КОНЕЦ ВСТАВКИ. Далее остаётся исходный Window:SelectTab(1).
Window:SelectTab(1)
refreshCash()
refreshRecordCache()
bindAntiMacro()
local statusAt = 0
local lastStatus, lastDiagnostic, lastAnti = "", "", ""
local function setParagraph(paragraph, text)
    if paragraph and type(paragraph.SetDesc) == "function" then paragraph:SetDesc(text) end
end
-- Фоновые ошибки разделены: сбой одного модуля не отключает остальные.
local function safeCycle(key, fn)
    local ok, err = pcall(fn)
    if not ok then problem(key, err) end
end
local function statusCycle()
    if os.clock() - statusAt < 1 then return end
    statusAt = os.clock()
    local count = #S.entries > 0 and #S.entries or #S.macro.steps
    local mode = S.recording and "Запись" or (S.playing and "Воспроизведение" or "Ожидание")
    local nextStep = S.playing and S.macro.steps[S.cursor] or nil
    local text = mode .. " | шагов: " .. count .. " | позиция: " .. S.cursor .. " | Cash: " .. tostring(cashNow())
        .. " | очередь снимков: " .. S.pending .. (nextStep and (" | порог: " .. nextStep.cash) or "")
    local ps = LP:FindFirstChild("PlayerScripts")
    local client = ps and ps:FindFirstChild("AntiMacroClient")
    local info = WS:FindFirstChild("Info")
    local wave = info and info:FindFirstChild("Wave")
    local diagnosticText = "Файлы: " .. tostring(fileOK) .. " | Удаление: " .. tostring(deleteOK)
        .. " | Hook установлен: " .. tostring(S.recordEnabled) .. " | AntiMacroClient: " .. tostring(client ~= nil)
        .. " | Wave: " .. tostring(wave and wave.Value) .. "\nПоследняя проблема: " .. S.lastError
    if text ~= lastStatus then setParagraph(statusParagraph, text); lastStatus = text end
    if diagnosticText ~= lastDiagnostic then setParagraph(diagnostics, diagnosticText); lastDiagnostic = diagnosticText end
    if S.antiStatus ~= lastAnti then setParagraph(antiParagraph, S.antiStatus); lastAnti = S.antiStatus end
end
task.spawn(function()
    while S.alive and not Fluent.Unloaded do
        safeCycle("cash", refreshCash)
        safeCycle("record-cache", refreshRecordCache)
        if dispatcher and dispatcher.fault then
            local fault = dispatcher.fault
            dispatcher.fault = nil
            recordingError(fault)
        end
        safeCycle("anti-bind", bindAntiMacro)
        safeCycle("map", function()
            guiGate("map", "Voting", opt("AutoMap", false), opt("Map", "Area 51"), "VoteForMap", opt("Map", "Area 51"))
        end)
        safeCycle("difficulty", function()
            guiGate("difficulty", "ComplicationVoting", opt("AutoDifficulty", false), opt("Difficulty", "Normal"),
                "VoteForComplication", opt("Difficulty", "Normal"))
        end)
        safeCycle("end", endCycle)
        safeCycle("elevator", elevatorCycle)
        safeCycle("speed", speedCycle)
        safeCycle("walk", walkCycle)
        safeCycle("pump", hub.Pump)
        safeCycle("status", statusCycle)
        task.wait(0.25)
    end
    hub.Destroy("Окно закрыто")
end)
if managersReady then
