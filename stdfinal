    -- BEGIN WEBHOOK PURE HELPERS
    local function trim(s) return (s:match("^%s*(.-)%s*$")) end
    local function clean(s, rich)
        if type(s) ~= "string" then return "" end
        if rich then s = s:gsub("<[^>]->", "") end
        return trim(s:gsub("[%c]", " "))
    end
    local function duration(seconds)
        if not finite(seconds) or seconds < 0 then return "Недоступно: CurrentSession не найден" end
        seconds = math.floor(seconds)
        return string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
    end
    local function endpoint(value)
        if type(value) ~= "string" then return nil, "Введите URL webhook" end
        local url = trim(value)
        if #url > 512 then return nil, "Слишком длинный URL webhook" end
        local root = url:match("^(.-)%?wait=true$") or url
        root = root:gsub("/$", "")
        -- Только обычный Discord webhook, без прокси, thread_id и дополнительных query.
        local id, token = root:match("^https://discord%.com/api/webhooks/(%d+)/([%w_%-%.]+)$")
        if not id then
            id, token = root:match("^https://discord%.com/api/v%d+/webhooks/(%d+)/([%w_%-%.]+)$")
        end
        if not id or not token or #id > 24 then
            return nil, "Нужна прямая HTTPS-ссылка Discord: api/webhooks/ID/TOKEN"
        end
        return root .. "?wait=true", id
    end
    local function outcome(title)
