        if text == "defeat" or text == "поражение" or trim(title) == "Поражение" then return "Поражение", 15158332 end
        return nil
    end
    local function stableEnough(r, now)
        return r.changedAt and now - r.seenAt >= MIN_SETTLE and now - r.changedAt >= QUIET
    end
    -- END WEBHOOK PURE HELPERS

    local function chooseHTTP(name)
        local candidates = {
            { "request", request }, { "http_request", http_request },
            { "http.request", type(http) == "table" and http.request or nil },
            { "syn.request", type(syn) == "table" and syn.request or nil },
        }
        for _, pair in ipairs(candidates) do
            if (name == "Авто" or name == pair[1]) and type(pair[2]) == "function" then
                return pair[2], pair[1]
            end
        end
        return nil, "Выбранная HTTP-функция недоступна"
    end
    local function responseInfo(response)
        if type(response) ~= "table" then return nil, nil, {} end
        local code = tonumber(response.StatusCode or response.Status or response.status_code or response.status)
        if not finite(code) or code % 1 ~= 0 or code < 100 or code > 599 then code = nil end
        local body = response.Body or response.body
        local headers = response.Headers or response.headers
        local decoded
        if type(body) == "string" and #body <= 65536 then
            local ok, data = pcall(Http.JSONDecode, Http, body)
            if ok and type(data) == "table" then decoded = data end
        end
        return code, decoded, type(headers) == "table" and headers or {}
    end
    local function headerNumber(headers, name)
        for k, v in pairs(headers) do
            if type(k) == "string" and k:lower() == name then
                local n = tonumber(v)
                if finite(n) and n >= 0 then return n end
            end
        end
        return nil
    end
    local function applyRateLimit(code, data, headers)
        local waitFor
        if code == 429 then
            local bodyWait = data and tonumber(data.retry_after)
            if not finite(bodyWait) or bodyWait < 0 then bodyWait = 0 end
            waitFor = math.max(bodyWait, headerNumber(headers, "retry-after") or 0,
                headerNumber(headers, "x-ratelimit-reset-after") or 0)
            -- Если сервер не сообщил срок, запрещаем следующие тесты до перезапуска сессии.
            if waitFor <= 0 then P.nextHTTP = math.huge; return end
        elseif headerNumber(headers, "x-ratelimit-remaining") == 0 then
            waitFor = headerNumber(headers, "x-ratelimit-reset-after")
        end
        if waitFor then P.nextHTTP = math.max(P.nextHTTP, os.clock() + waitFor + 0.25) end
    end
    local function finish(r, text)
        r.finished, r.message = true, text
        status(text)
    end
    local function tickTicket(ticket)
        if not ticket.done and os.clock() - ticket.started >= HTTP_TIMEOUT then
            if not ticket.timedOut then
                ticket.timedOut = true
                ticket.message = "HTTP: таймаут; исход неизвестен, повтор не выполняется"
            end
        end
        return ticket.done or ticket.timedOut
    end
    local function send(body, url, webhookId, fn, driver, result)
        if P.pending then return nil, "Предыдущий HTTP-запрос ещё выполняется" end
        if P.blockedURL == url then return nil, "Этот webhook вернул HTTP 401/403/404; замените URL" end
        if os.clock() < P.nextHTTP then return nil, "Ожидание после ограничения Discord; повтор не отправлен" end
        local ticket = { started = os.clock(), done = false, driver = driver }
        P.pending = ticket
        if result then
            -- До task.spawn и вызова HTTP: повторный запуск хаба не повторит POST.
            result.attempted, result.ticket = true, ticket
        end
        task.spawn(function()
            local ok, response = pcall(fn, {
                Url = url, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = body,
            })
            -- Не печатаем response или исключение: исполнитель может включить в них секретный URL.
            local parsed, failure = pcall(function()
                if not ok then
                    ticket.message = "HTTP-исключение; исход неизвестен, автоповтора нет"
                    return
                end
                local code, data, headers = responseInfo(response)
                ticket.code = code
                applyRateLimit(code, data, headers)
                if code == 200 and data and type(data.id) == "string" and data.id:match("^%d+$")
                    and data.webhook_id == webhookId then
                    ticket.confirmed, ticket.messageId = true, data.id
                    ticket.message = "Discord подтвердил сообщение; HTTP 200; API: " .. driver
                elseif code == 401 or code == 403 or code == 404 then
                    P.blockedURL = url
                    ticket.message = "Discord: HTTP " .. code .. "; URL заблокирован для следующих отправок"
                elseif code == 429 then
                    ticket.message = "Discord: HTTP 429; лимит запросов, автоповтора нет"
                elseif code and code >= 400 and code < 500 then
                    ticket.message = "Discord отклонил запрос: HTTP " .. code .. "; автоповтора нет"
                elseif code then
                    ticket.message = "HTTP " .. code .. ": доставка не подтверждена; автоповтора нет"
                else
                    ticket.message = "Неизвестный формат HTTP-ответа; доставка не подтверждена"
                end
            end)
            if not parsed then ticket.message = "Ошибка разбора HTTP-ответа; доставка не подтверждена" end
            response, failure = nil, nil
            ticket.done = true
            if P.pending == ticket then P.pending = nil end
            if result then
                result.finished, result.message = true, ticket.message
            end
