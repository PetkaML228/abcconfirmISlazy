-- ═══════════════════════════════════════════════════════════════
-- КОНСТАНТЫ — COMMANDER
-- ═══════════════════════════════════════════════════════════════

local CMD_ABILITY_NAME  = "Call Of Arms"
local CMD_TYPE          = "Commander"
local CMD_BUFF_DURATION = 10.0
local CMD_COOLDOWN      = 30.0
local CMD_LEAD          = 0.1

-- ═══════════════════════════════════════════════════════════════
-- КОНСТАНТЫ — GLADIATOR
-- ═══════════════════════════════════════════════════════════════

local GLAD_ABILITY_NAME   = "Warrior's Call"
local GLAD_TYPE           = "Gladiator"
local GLAD_COOLDOWN       = 30.1
local GLAD_MIN_LEVEL      = 3
local GLAD_ACTIVATE_DELAY = 1.3
local GLAD_STUN_RETRY     = 2
local GLAD_MAX_RETRIES    = 10

-- ═══════════════════════════════════════════════════════════════
-- КОНСТАНТЫ — ОЧЕРЕДЬ ЗАПРОСОВ
-- ═══════════════════════════════════════════════════════════════

-- Минимальная пауза между любыми двумя InvokeServer вызовами.
-- Commander использует этот же интервал.
-- Gladiator использует GLAD_ACTIVATE_DELAY (больше или равно).
local QUEUE_MIN_INTERVAL = 0.35  -- секунд между запросами

-- ═══════════════════════════════════════════════════════════════
-- ОБЩИЕ НАСТРОЙКИ
-- ═══════════════════════════════════════════════════════════════

local CMD_MAX_RETRIES = 10
local debugMode       = false

-- ═══════════════════════════════════════════════════════════════
-- ЕДИНАЯ ОЧЕРЕДЬ ЗАПРОСОВ
--
-- Проблема которую решает очередь:
--   Commander ждёт T секунд и вызывает InvokeServer
--   Gladiator в это же время вызывает InvokeServer для своей башни
--   Сервер получает два запроса одновременно → возвращает nil/false
--   Commander считает что башня на кулдауне → пропускает её
--
-- Решение:
--   Все InvokeServer идут через одну очередь (FIFO с приоритетом).
--   Между запросами — пауза QUEUE_MIN_INTERVAL.
--   Commander запросы имеют приоритет = 1 (выше).
--   Gladiator запросы имеют приоритет = 2 (ниже).
--   При равном приоритете — порядок поступления (FIFO).
--
-- Использование:
--   RequestQueue.push(priority, fn, callback)
--   fn()        — функция которая делает InvokeServer, возвращает результат
--   callback(result) — вызывается когда запрос выполнен
-- ═══════════════════════════════════════════════════════════════

local RequestQueue = (function()
    local queue       = {}   -- { priority, fn, callback }
    local isRunning   = false
    local lastSendAt  = 0

    local function insertSorted(item)
        -- Вставка с сохранением сортировки по приоритету (меньше = выше)
        local inserted = false
        for i = 1, #queue do
            if item.priority < queue[i].priority then
                table.insert(queue, i, item)
                inserted = true
                break
            end
        end
        if not inserted then
            table.insert(queue, item)
        end
    end

    local processQueue  -- forward declaration

    processQueue = function()
        if #queue == 0 then
            isRunning = false
            return
        end

        isRunning = true
        local item = table.remove(queue, 1)

        -- Считаем сколько ждать чтобы соблюсти минимальный интервал
        local now     = os.clock()
        local waitFor = math.max(0, lastSendAt + QUEUE_MIN_INTERVAL - now)

        task.delay(waitFor, function()
            lastSendAt = os.clock()

            local ok, result = pcall(item.fn)
            if not ok then
                warn("[Queue] pcall упал: " .. tostring(result))
                result = nil
            end

            -- Возвращаем результат через callback
            local cbOk, cbErr = pcall(item.callback, result)
            if not cbOk then
                warn("[Queue] callback упал: " .. tostring(cbErr))
            end

            -- Следующий элемент
            processQueue()
        end)
    end

    local function push(priority, fn, callback)
        insertSorted({ priority = priority, fn = fn, callback = callback })
        if not isRunning then
            processQueue()
        end
    end

    local function size()
        return #queue
    end

    return { push = push, size = size }
end)()

-- ═══════════════════════════════════════════════════════════════
-- СОСТОЯНИЕ — COMMANDER
-- ═══════════════════════════════════════════════════════════════

local CmdState = {
    Enabled         = false,
    Commanders      = {},
    QueueIndex      = 1,
    ActivationCount = 0,
    ScheduledThread = nil,
    LastChainTime   = 0,
    RetryCount      = 0,
}

-- ═══════════════════════════════════════════════════════════════
-- СОСТОЯНИЕ — GLADIATOR
-- ═══════════════════════════════════════════════════════════════

local GladState = {
    Enabled         = false,
    Gladiators      = {},
    ActivationCount = 0,
    ManagerThread   = nil,
    StunThreads     = {},
}

-- ═══════════════════════════════════════════════════════════════
-- ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
-- ═══════════════════════════════════════════════════════════════

local function GetReplicator(model)
    return model:FindFirstChild("Replicator")
end

local function IsOwned(model)
    local ok, result = pcall(function()
        local rep = GetReplicator(model)
        if not rep then return false end
        local ownerId = rep:GetAttribute("OwnerId")
        if ownerId then return ownerId == LocalPlayer.UserId end
        return rep:GetAttribute("Owner") == LocalPlayer.Name
    end)
    return ok and result
end

local function GetType(model)
    local ok, result = pcall(function()
        local rep = GetReplicator(model)
        if not rep then return "" end
        return rep:GetAttribute("Type") or ""
    end)
    return ok and result or ""
end

local function GetLevel(model)
    local ok, result = pcall(function()
        local rep = GetReplicator(model)
        if not rep then return 0 end
        return rep:GetAttribute("Upgrade") or 0
    end)
    return ok and result or 0
end

local function IsStunned(model)
    local ok, result = pcall(function()
        local rep = GetReplicator(model)
        if not rep then return false end

        local stunned = rep:GetAttribute("Stunned")
        if stunned == true then return true end

        local stunTime = rep:GetAttribute("StunTime")
        if type(stunTime) == "number" and stunTime > os.clock() then
            return true
        end

        local status = rep:GetAttribute("Status")
        if type(status) == "string" and status:lower():find("stun") then
            return true
        end

        return false
    end)
    return ok and result
end

local function DbgLog(msg)
    if debugMode then warn("[AutoChain][DBG] " .. tostring(msg)) end
end

-- ═══════════════════════════════════════════════════════════════
-- СКАНИРОВАНИЕ
-- ═══════════════════════════════════════════════════════════════

local function ScanCommanders()
    local found = {}
    local ok, err = pcall(function()
        for _, model in ipairs(TowersFolder:GetChildren()) do
            if model:IsA("Model")
            and IsOwned(model)
            and GetType(model) == CMD_TYPE
            then
                table.insert(found, {
                    model         = model,
                    name          = model.Name,
                    level         = GetLevel(model),
                    cooldownUntil = 0,
                })
            end
        end
    end)
    if not ok then
        warn("[Commander] Ошибка сканирования: " .. tostring(err))
    end
    table.sort(found, function(a, b) return a.level > b.level end)
    warn(string.format("[Commander] Найдено: %d", #found))
    for i, c in ipairs(found) do
        warn(string.format("  [%d] %s (ур.%d)", i, c.name, c.level))
    end
    if #found > 0 and #found < 5 then
        warn(string.format("[Commander][WARN] %d/5 — разрыв %.0fс",
            #found, CMD_COOLDOWN - (#found * CMD_BUFF_DURATION)))
    end
    return found
end

local function ScanGladiators()
    local found   = {}
    local skipped = 0
    local ok, err = pcall(function()
        for _, model in ipairs(TowersFolder:GetChildren()) do
            if model:IsA("Model")
            and IsOwned(model)
            and GetType(model) == GLAD_TYPE
            then
                local level = GetLevel(model)
                if level >= GLAD_MIN_LEVEL then
                    table.insert(found, {
                        model         = model,
                        name          = model.Name,
                        level         = level,
                        cooldownUntil = 0,
                        stunRetries   = 0,
                        inStunRetry   = false,
                    })
                else
                    skipped += 1
                    DbgLog(string.format("[Gladiator] Пропущен ур.%d: %s",
                        level, model.Name))
                end
            end
        end
    end)
    if not ok then
        warn("[Gladiator] Ошибка сканирования: " .. tostring(err))
    end
    table.sort(found, function(a, b) return a.level > b.level end)
    warn(string.format("[Gladiator] Найдено: %d (низкий ур.: %d)",
        #found, skipped))
    for i, g in ipairs(found) do
        warn(string.format("  [%d] %s (ур.%d)", i, g.name, g.level))
    end
    if skipped > 0 then
        warn(string.format("[Gladiator][INFO] %d башен ниже %d ур. пропущено",
            skipped, GLAD_MIN_LEVEL))
    end
    return found
end

-- ═══════════════════════════════════════════════════════════════
-- АКТИВАЦИЯ — COMMANDER
-- Использует очередь с приоритетом 1 (высокий)
-- ═══════════════════════════════════════════════════════════════

-- Вызывается когда очередь вернула результат
local function OnCommanderResult(cmd, result, ok)
    if not CmdState.Enabled then return end

    DbgLog(string.format("[Commander] '%s': ok=%s result=%s",
        cmd.name, tostring(ok), tostring(result)))

    local success = false

    if not ok then
        warn("[Commander] Ошибка вызова: " .. tostring(result))
    elseif result == nil then
        warn("[Commander] nil ответ — очередь защитила, но сервер всё равно вернул nil: "
            .. cmd.name)
    elseif result == false then
        DbgLog("[Commander] Отклонено: " .. cmd.name)
    elseif type(result) == "string"
    and (result:lower():find("cooldown") or result:lower():find("error")) then
        DbgLog("[Commander] Ошибка сервера: " .. result)
    else
        -- Успех
        cmd.cooldownUntil         = os.clock() + CMD_COOLDOWN
        CmdState.ActivationCount += 1
        CmdState.RetryCount       = 0
        warn(string.format("[Commander] ✓ %s (всего: %d)",
            cmd.name, CmdState.ActivationCount))
        success = true
    end

    -- Планируем следующий шаг цепочки
    -- (CmdScheduleNext объявлена ниже, используем forward reference через замыкание)
    task.delay(0, function()
        if not CmdState.Enabled then return end
        if success then
            CmdState.LastChainTime = os.clock()
            CmdState.RetryCount    = 0
            CmdState.QueueIndex    = (CmdState.QueueIndex % #CmdState.Commanders) + 1
        else
            CmdState.RetryCount += 1
            if CmdState.RetryCount >= CMD_MAX_RETRIES then
                warn(string.format(
                    "[Commander][WARN] %d неудач подряд, пропуск '%s'",
                    CMD_MAX_RETRIES, cmd.name))
                CmdState.RetryCount = 0
                CmdState.QueueIndex =
                    (CmdState.QueueIndex % #CmdState.Commanders) + 1
            end
        end
        CmdScheduleNext()
    end)
end

-- CmdScheduleNext объявляем через local + присвоение чтобы
-- OnCommanderResult мог её вызывать до объявления
CmdScheduleNext = nil  -- forward declaration

local function _CmdScheduleNext()
    if not CmdState.Enabled then return end
    if #CmdState.Commanders == 0 then return end

    -- Чистим удалённые башни
    for i = #CmdState.Commanders, 1, -1 do
        if not CmdState.Commanders[i].model.Parent then
            warn("[Commander] Удалена: " .. CmdState.Commanders[i].name)
            table.remove(CmdState.Commanders, i)
        end
    end

    if #CmdState.Commanders == 0 then
        warn("[Commander] Все башни удалены. Остановка.")
        CmdState.Enabled = false
        return
    end

    if CmdState.QueueIndex > #CmdState.Commanders then
        CmdState.QueueIndex = 1
    end

    local cmd = CmdState.Commanders[CmdState.QueueIndex]
    local now = os.clock()

    local chainWait    = CmdState.LastChainTime == 0
        and 0
        or (CmdState.LastChainTime + CMD_BUFF_DURATION - CMD_LEAD) - now
    local cooldownWait = cmd.cooldownUntil - now
    local waitTime     = math.max(0, chainWait, cooldownWait)

    DbgLog(string.format(
        "[Commander] [%d] %s | цепь=%.2fс кд=%.2fс ждём=%.2fс | очередь=%d",
        CmdState.QueueIndex, cmd.name,
        math.max(0, chainWait), math.max(0, cooldownWait),
        waitTime, RequestQueue.size()))

    CmdState.ScheduledThread = task.delay(waitTime, function()
        if not CmdState.Enabled then return end

        -- Проверяем что модель ещё существует
        if not cmd.model or not cmd.model.Parent then
            warn("[Commander] Башня исчезла перед активацией: " .. cmd.name)
            CmdState.QueueIndex =
                (CmdState.QueueIndex % #CmdState.Commanders) + 1
            CmdScheduleNext()
            return
        end

        -- Отправляем в очередь с приоритетом 1 (Commander = высокий)
        RequestQueue.push(
            1,  -- приоритет: Commander выше Gladiator
            function()
                return RemoteFunction:InvokeServer(
                    "Troops", "Abilities", "Activate",
                    { Name = CMD_ABILITY_NAME, Troop = cmd.model }
                )
            end,
            function(result)
                OnCommanderResult(cmd, result, true)
            end
        )
    end)
end

-- Устанавливаем forward reference
CmdScheduleNext = _CmdScheduleNext

-- ═══════════════════════════════════════════════════════════════
-- АКТИВАЦИЯ — GLADIATOR (одна башня)
-- Использует очередь с приоритетом 2 (низкий)
--
-- Возвращает через callback:
--   "ok" | "stun" | "cooldown" | "nil" | "removed" | "error"
-- ═══════════════════════════════════════════════════════════════

local function ActivateGladiatorQueued(g, callback)
    if not g.model or not g.model.Parent then
        callback("removed")
        return
    end

    if GetLevel(g.model) < GLAD_MIN_LEVEL then
        callback("cooldown")
        return
    end

    -- Проверяем стан до добавления в очередь — не тратим слот
    if IsStunned(g.model) then
        DbgLog("[Gladiator] Застанен локально: " .. g.name)
        callback("stun")
        return
    end

    -- Проверяем кулдаун до добавления в очередь
    local now = os.clock()
    if g.cooldownUntil > now then
        DbgLog(string.format("[Gladiator] КД %.2fс: %s",
            g.cooldownUntil - now, g.name))
        callback("cooldown")
        return
    end

    -- Добавляем в очередь с приоритетом 2 (Gladiator = низкий)
    RequestQueue.push(
        2,  -- приоритет: Gladiator ниже Commander
        function()
            return RemoteFunction:InvokeServer(
                "Troops", "Abilities", "Activate",
                { Name = GLAD_ABILITY_NAME, Troop = g.model }
            )
        end,
        function(result)
            DbgLog(string.format("[Gladiator] '%s' result=%s",
                g.name, tostring(result)))

            if result == nil then
                warn(string.format("[Gladiator] nil '%s' — сервер перегружен",
                    g.name))
                callback("nil")
                return
            end

            if result == false then
                DbgLog("[Gladiator] false (стан?): " .. g.name)
                callback("stun")
                return
            end

            if type(result) == "string" then
                local lower = result:lower()
                if lower:find("cooldown") then callback("cooldown") return end
                if lower:find("stun")     then callback("stun")     return end
                if lower:find("error")    then callback("error")    return end
            end

            -- Успех
            g.cooldownUntil           = os.clock() + GLAD_COOLDOWN
            g.stunRetries             = 0
            g.inStunRetry             = false
            GladState.ActivationCount += 1
            warn(string.format("[Gladiator] ✓ %s (всего: %d)",
                g.name, GladState.ActivationCount))
            callback("ok")
        end
    )
end

-- ═══════════════════════════════════════════════════════════════
-- GLADIATOR — STUN RETRY ПОТОК
-- ═══════════════════════════════════════════════════════════════

local GladStunRetryLoop  -- forward declaration

GladStunRetryLoop = function(g)
    if not GladState.Enabled then
        g.inStunRetry = false
        return
    end
    if not g.model or not g.model.Parent then
        g.inStunRetry = false
        return
    end

    ActivateGladiatorQueued(g, function(status)
        if status == "ok" then
            g.inStunRetry = false
            DbgLog("[Gladiator] Stun-поток успех: " .. g.name)

        elseif status == "stun" or status == "nil" then
            g.stunRetries = (g.stunRetries or 0) + 1
            if g.stunRetries >= GLAD_MAX_RETRIES then
                warn(string.format(
                    "[Gladiator] '%s' стан %d попыток → сброс %.0fс",
                    g.name, g.stunRetries, GLAD_COOLDOWN))
                g.stunRetries   = 0
                g.inStunRetry   = false
                g.cooldownUntil = os.clock() + GLAD_COOLDOWN
            else
                GladState.StunThreads[g] = task.delay(
                    GLAD_STUN_RETRY, function()
                        GladStunRetryLoop(g)
                    end)
            end

        elseif status == "cooldown" then
            g.inStunRetry = false

        elseif status == "removed" then
            g.inStunRetry = false

        else
            g.stunRetries = (g.stunRetries or 0) + 1
            GladState.StunThreads[g] = task.delay(
                GLAD_STUN_RETRY, function()
                    GladStunRetryLoop(g)
                end)
        end
    end)
end

-- ═══════════════════════════════════════════════════════════════
-- GLADIATOR — МЕНЕДЖЕР
-- ═══════════════════════════════════════════════════════════════

local GladManager  -- forward declaration

GladManager = function()
    if not GladState.Enabled then return end

    -- Чистим удалённые башни
    for i = #GladState.Gladiators, 1, -1 do
        local g = GladState.Gladiators[i]
        if not g.model or not g.model.Parent then
            warn("[Gladiator] Менеджер: удалена " .. tostring(g.name))
            if GladState.StunThreads[g] then
                pcall(task.cancel, GladState.StunThreads[g])
                GladState.StunThreads[g] = nil
            end
            table.remove(GladState.Gladiators, i)
        end
    end

    if #GladState.Gladiators == 0 then
        warn("[Gladiator] Все башни удалены. Остановка.")
        GladState.Enabled = false
        return
    end

    local activated   = 0
    local skippedStun = 0
    local skippedCD   = 0
    local nilCount    = 0
    local nextCDTime  = math.huge

    local i = 1

    local function processNext()
        if not GladState.Enabled then return end

        if i > #GladState.Gladiators then
            -- Проход завершён — вычисляем когда следующий
            local sleepTime
            if nextCDTime == math.huge then
                sleepTime = GLAD_COOLDOWN
            else
                sleepTime = math.max(0.5, nextCDTime - os.clock())
            end

            if activated > 0 or nilCount > 0 then
                warn(string.format(
                    "[Gladiator] Проход: ✓%d стан=%d кд=%d nil=%d → сон %.1fс",
                    activated, skippedStun, skippedCD, nilCount, sleepTime))
            else
                DbgLog(string.format(
                    "[Gladiator] Проход (нет активаций): сон %.1fс", sleepTime))
            end

            GladState.ManagerThread = task.delay(sleepTime, GladManager)
            return
        end

        local g = GladState.Gladiators[i]
        i += 1

        -- Башня в stun-потоке — пропускаем
        if g.inStunRetry then
            skippedStun += 1
            processNext()
            return
        end

        -- Башня на кулдауне — пропускаем
        local cdLeft = g.cooldownUntil - os.clock()
        if cdLeft > 0 then
            skippedCD += 1
            if g.cooldownUntil < nextCDTime then
                nextCDTime = g.cooldownUntil
            end
            processNext()
            return
        end

        -- Отправляем в очередь — результат получаем в callback
        -- ВАЖНО: между отправками в очередь делаем паузу GLAD_ACTIVATE_DELAY
        -- чтобы не засыпать очередь сразу всеми башнями
        -- Пауза реализована через task.delay перед следующим processNext

        ActivateGladiatorQueued(g, function(status)
            if status == "ok" then
                activated += 1
                -- Следующую башню ставим в очередь через GLAD_ACTIVATE_DELAY
                task.delay(GLAD_ACTIVATE_DELAY, processNext)

            elseif status == "stun" then
                skippedStun     += 1
                g.inStunRetry    = true
                g.stunRetries    = 0
                GladState.StunThreads[g] = task.delay(
                    GLAD_STUN_RETRY, function()
                        GladStunRetryLoop(g)
                    end)
                -- Застан не блокирует — сразу к следующей
                processNext()

            elseif status == "nil" then
                nilCount += 1
                warn(string.format(
                    "[Gladiator] nil #%d — пауза %.1fс",
                    nilCount, GLAD_ACTIVATE_DELAY + 0.5))
                -- Башня не получила кулдаун — попробуем в следующем проходе
                task.delay(GLAD_ACTIVATE_DELAY + 0.5, processNext)

            elseif status == "cooldown" then
                skippedCD += 1
                if g.cooldownUntil < nextCDTime then
                    nextCDTime = g.cooldownUntil
                end
                processNext()

            elseif status == "removed" then
                processNext()

            else
                warn("[Gladiator] Ошибка: " .. tostring(g.name))
                task.delay(1, processNext)
            end
        end)
    end

    processNext()
end

