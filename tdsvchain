-- ═══════════════════════════════════════════════════════════════
-- КОНСТАНТЫ — COMMANDER
-- ═══════════════════════════════════════════════════════════════

local CMD_ABILITY_NAME  = "Call Of Arms"
local CMD_TYPE          = "Commander"
local CMD_BUFF_DURATION = 10.0
local CMD_COOLDOWN      = 50.0
local CMD_LEAD          = 0.1

-- ═══════════════════════════════════════════════════════════════
-- КОНСТАНТЫ — GLADIATOR
-- ═══════════════════════════════════════════════════════════════

local GLAD_ABILITY_NAME  = "Warrior's Call"
local GLAD_TYPE          = "Gladiator"
local GLAD_COOLDOWN      = 30.0
local GLAD_MIN_LEVEL     = 3      -- способность доступна с 3 уровня
local GLAD_STUN_RETRY    = 1.0   -- пауза перед повтором при стане (сек)
local GLAD_MAX_RETRIES   = 15    -- максимум попыток при стане прежде чем пропустить

-- ═══════════════════════════════════════════════════════════════
-- ОБЩИЕ НАСТРОЙКИ
-- ═══════════════════════════════════════════════════════════════

local CMD_MAX_RETRIES = 10
local debugMode       = false

-- ═══════════════════════════════════════════════════════════════
-- СОСТОЯНИЕ — COMMANDER
-- ═══════════════════════════════════════════════════════════════

local CmdState = {
    Enabled         = false,
    Commanders      = {},
    QueueIndex      = 1,
    ActivationCount = 0,
    ScheduledThread = nil,
    LastChainTime   = 0,
    RetryCount      = 0,
}

-- ═══════════════════════════════════════════════════════════════
-- СОСТОЯНИЕ — GLADIATOR
-- ═══════════════════════════════════════════════════════════════

local GladState = {
    Enabled         = false,
    Gladiators      = {},
    ActivationCount = 0,
    -- Потоки каждого гладиатора хранятся внутри самого объекта g.thread
}

-- ═══════════════════════════════════════════════════════════════
-- ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
-- ═══════════════════════════════════════════════════════════════

local function GetReplicator(model)
    return model:FindFirstChild("Replicator")
end

local function IsOwned(model)
    local ok, result = pcall(function()
        local rep = GetReplicator(model)
        if not rep then return false end
        local ownerId = rep:GetAttribute("OwnerId")
        if ownerId then return ownerId == LocalPlayer.UserId end
        return rep:GetAttribute("Owner") == LocalPlayer.Name
    end)
    return ok and result
end

local function GetType(model)
    local ok, result = pcall(function()
        local rep = GetReplicator(model)
        if not rep then return "" end
        return rep:GetAttribute("Type") or ""
    end)
    return ok and result or ""
end

local function GetLevel(model)
    local ok, result = pcall(function()
        local rep = GetReplicator(model)
        if not rep then return 0 end
        return rep:GetAttribute("Upgrade") or 0
    end)
    return ok and result or 0
end

-- Проверка стана — три варианта атрибута
local function IsStunned(model)
    local ok, result = pcall(function()
        local rep = GetReplicator(model)
        if not rep then return false end

        -- Вариант 1: булевый флаг
        local stunned = rep:GetAttribute("Stunned")
        if stunned == true then return true end

        -- Вариант 2: числовой таймер (значение = время окончания стана)
        local stunTime = rep:GetAttribute("StunTime")
        if type(stunTime) == "number" and stunTime > os.clock() then
            return true
        end

        -- Вариант 3: строковый статус
        local status = rep:GetAttribute("Status")
        if type(status) == "string" and status:lower():find("stun") then
            return true
        end

        return false
    end)
    return ok and result
end

local function DbgLog(msg)
    if debugMode then warn("[AutoChain][DBG] " .. tostring(msg)) end
end

-- ═══════════════════════════════════════════════════════════════
-- СКАНИРОВАНИЕ
-- ═══════════════════════════════════════════════════════════════

local function ScanCommanders()
    local found = {}
    local ok, err = pcall(function()
        for _, model in ipairs(TowersFolder:GetChildren()) do
            if model:IsA("Model")
            and IsOwned(model)
            and GetType(model) == CMD_TYPE
            then
                table.insert(found, {
                    model         = model,
                    name          = model.Name,
                    level         = GetLevel(model),
                    cooldownUntil = 0,
                })
            end
        end
    end)
    if not ok then
        warn("[Commander] Ошибка сканирования: " .. tostring(err))
    end
    table.sort(found, function(a, b) return a.level > b.level end)
    warn(string.format("[Commander] Найдено: %d", #found))
    for i, c in ipairs(found) do
        warn(string.format("  [%d] %s (ур.%d)", i, c.name, c.level))
    end
    if #found > 0 and #found < 5 then
        warn(string.format("[Commander][WARN] %d/5 — разрыв %.0fс",
            #found, CMD_COOLDOWN - (#found * CMD_BUFF_DURATION)))
    end
    return found
end

local function ScanGladiators()
    local found    = {}
    local skipped  = 0
    local ok, err  = pcall(function()
        for _, model in ipairs(TowersFolder:GetChildren()) do
            if model:IsA("Model")
            and IsOwned(model)
            and GetType(model) == GLAD_TYPE
            then
                local level = GetLevel(model)
                if level >= GLAD_MIN_LEVEL then
                    -- Каждый гладиатор — отдельная запись со своим потоком
                    table.insert(found, {
                        model         = model,
                        name          = model.Name,
                        level         = level,
                        cooldownUntil = 0,
                        retryCount    = 0,
                        thread        = nil,  -- task.delay handle
                    })
                else
                    skipped += 1
                    DbgLog(string.format(
                        "[Gladiator] Пропущен (ур.%d < %d): %s",
                        level, GLAD_MIN_LEVEL, model.Name))
                end
            end
        end
    end)
    if not ok then
        warn("[Gladiator] Ошибка сканирования: " .. tostring(err))
    end
    table.sort(found, function(a, b) return a.level > b.level end)
    warn(string.format("[Gladiator] Найдено: %d (пропущено низкоур.: %d)",
        #found, skipped))
    for i, g in ipairs(found) do
        warn(string.format("  [%d] %s (ур.%d)", i, g.name, g.level))
    end
    if skipped > 0 then
        warn(string.format(
            "[Gladiator][INFO] %d башен ниже %d ур. — способность недоступна",
            skipped, GLAD_MIN_LEVEL))
    end
    return found
end

-- ═══════════════════════════════════════════════════════════════
-- АКТИВАЦИЯ — COMMANDER
-- ═══════════════════════════════════════════════════════════════

local function ActivateCommander(cmd)
    if not cmd.model or not cmd.model.Parent then
        warn("[Commander] Удалён: " .. cmd.name)
        return false
    end

    local ok, result = pcall(function()
        return RemoteFunction:InvokeServer(
            "Troops", "Abilities", "Activate",
            { Name = CMD_ABILITY_NAME, Troop = cmd.model }
        )
    end)

    DbgLog(string.format("[Commander] '%s': ok=%s result=%s",
        cmd.name, tostring(ok), tostring(result)))

    if not ok then
        warn("[Commander] Ошибка вызова: " .. tostring(result))
        return false
    end
    if result == false then
        DbgLog("[Commander] Отклонено: " .. cmd.name)
        return false
    end
    if type(result) == "string"
    and (result:lower():find("cooldown") or result:lower():find("error")) then
        DbgLog("[Commander] Ошибка сервера: " .. result)
        return false
    end

    cmd.cooldownUntil         = os.clock() + CMD_COOLDOWN
    CmdState.ActivationCount += 1
    CmdState.RetryCount       = 0
    warn(string.format("[Commander] ✓ %s (всего: %d)",
        cmd.name, CmdState.ActivationCount))
    return true
end

-- ═══════════════════════════════════════════════════════════════
-- АКТИВАЦИЯ — GLADIATOR (одна башня)
-- Возвращает: "ok" | "stun" | "cooldown" | "error" | "removed"
-- ═══════════════════════════════════════════════════════════════

local function ActivateGladiator(g)
    -- Башня удалена с карты
    if not g.model or not g.model.Parent then
        return "removed"
    end

    -- Уровень мог измениться — перепроверяем
    if GetLevel(g.model) < GLAD_MIN_LEVEL then
        DbgLog("[Gladiator] Уровень < " .. GLAD_MIN_LEVEL .. ": " .. g.name)
        return "cooldown" -- ждём как будто на кулдауне
    end

    -- Проверяем стан ДО запроса — экономим трафик
    if IsStunned(g.model) then
        DbgLog("[Gladiator] Застанен: " .. g.name)
        return "stun"
    end

    -- Локальная проверка кулдауна
    local now = os.clock()
    if g.cooldownUntil > now then
        DbgLog(string.format("[Gladiator] КД %.1fс: %s",
            g.cooldownUntil - now, g.name))
        return "cooldown"
    end

    local ok, result = pcall(function()
        return RemoteFunction:InvokeServer(
            "Troops", "Abilities", "Activate",
            { Name = GLAD_ABILITY_NAME, Troop = g.model }
        )
    end)

    DbgLog(string.format("[Gladiator] '%s': ok=%s result=%s",
        g.name, tostring(ok), tostring(result)))

    if not ok then
        warn("[Gladiator] Ошибка вызова: " .. tostring(result))
        return "error"
    end
    if result == false then
        -- Сервер отклонил — скорее всего стан на серверной стороне
        DbgLog("[Gladiator] Отклонено сервером: " .. g.name)
        return "stun"
    end
    if type(result) == "string" then
        local lower = result:lower()
        if lower:find("cooldown") then return "cooldown" end
        if lower:find("stun")     then return "stun"     end
        if lower:find("error")    then return "error"    end
    end

    g.cooldownUntil          = os.clock() + GLAD_COOLDOWN
    g.retryCount             = 0
    GladState.ActivationCount += 1
    warn(string.format("[Gladiator] ✓ %s (всего: %d)",
        g.name, GladState.ActivationCount))
    return "ok"
end

-- ═══════════════════════════════════════════════════════════════
-- GLADIATOR — ПОТОК ОДНОЙ БАШНИ
--
-- Каждая башня запускает свой рекурсивный task.delay поток.
-- Потоки НЕ знают друг о друге и НЕ ждут друг друга.
-- Если несколько башен готовы одновременно — они активируются
-- параллельно с задержкой ~0мс (только latency сервера).
-- ═══════════════════════════════════════════════════════════════

local function GladLoop(g)
    -- Стоп-флаг проверяется в начале каждой итерации
    if not GladState.Enabled then return end

    -- Башня удалена — поток тихо завершается
    if not g.model or not g.model.Parent then
        warn("[Gladiator] Поток завершён (башня удалена): " .. tostring(g.name))
        return
    end

    local status = ActivateGladiator(g)

    if status == "ok" then
        -- ── Успех ──────────────────────────────────────────────
        -- Следующая попытка ровно через кулдаун минус упреждение
        local nextWait = GLAD_COOLDOWN - 0.3
        DbgLog(string.format("[Gladiator] '%s' OK → следующий через %.1fс",
            g.name, nextWait))
        g.thread = task.delay(nextWait, function()
            GladLoop(g)
        end)

    elseif status == "stun" then
        -- ── Стан ───────────────────────────────────────────────
        g.retryCount = (g.retryCount or 0) + 1

        if g.retryCount >= GLAD_MAX_RETRIES then
            -- Слишком долгий стан — делаем паузу на полный кулдаун
            -- чтобы не спамить сервер бесполезными запросами
            warn(string.format(
                "[Gladiator][WARN] '%s' в стане %d попыток подряд → пауза %.0fс",
                g.name, g.retryCount, GLAD_COOLDOWN))
            g.retryCount = 0
            g.thread = task.delay(GLAD_COOLDOWN, function()
                GladLoop(g)
            end)
        else
            DbgLog(string.format(
                "[Gladiator] '%s' стан (попытка %d/%d) → повтор через %.1fс",
                g.name, g.retryCount, GLAD_MAX_RETRIES, GLAD_STUN_RETRY))
            g.thread = task.delay(GLAD_STUN_RETRY, function()
                GladLoop(g)
            end)
        end

    elseif status == "cooldown" then
        -- ── Кулдаун ────────────────────────────────────────────
        -- Ждём ровно сколько осталось + маленький запас
        local remaining = math.max(0.5, g.cooldownUntil - os.clock())
        DbgLog(string.format("[Gladiator] '%s' КД → ждём %.1fс",
            g.name, remaining))
        g.thread = task.delay(remaining, function()
            GladLoop(g)
        end)

    elseif status == "removed" then
        -- ── Башня удалена ──────────────────────────────────────
        warn("[Gladiator] Поток завершён (removed): " .. tostring(g.name))
        -- Поток просто завершается, не перезапускается

    else
        -- ── Ошибка сети / сервера ──────────────────────────────
        warn(string.format("[Gladiator] Ошибка '%s' → повтор через 2с",
            tostring(g.name)))
        g.thread = task.delay(2, function()
            GladLoop(g)
        end)
    end
end

-- ═══════════════════════════════════════════════════════════════
-- COMMANDER ЦЕПОЧКА
-- ═══════════════════════════════════════════════════════════════

local function CmdScheduleNext()
    if not CmdState.Enabled then return end
    if #CmdState.Commanders == 0 then return end

    -- Чистим удалённые башни
    for i = #CmdState.Commanders, 1, -1 do
        if not CmdState.Commanders[i].model.Parent then
            warn("[Commander] Удалена: " .. CmdState.Commanders[i].name)
            table.remove(CmdState.Commanders, i)
        end
    end

    if #CmdState.Commanders == 0 then
        warn("[Commander] Все башни удалены. Остановка.")
        CmdState.Enabled = false
        return
    end

    if CmdState.QueueIndex > #CmdState.Commanders then
        CmdState.QueueIndex = 1
    end

    local cmd = CmdState.Commanders[CmdState.QueueIndex]
    local now = os.clock()

    local chainWait    = CmdState.LastChainTime == 0
        and 0
        or (CmdState.LastChainTime + CMD_BUFF_DURATION - CMD_LEAD) - now
    local cooldownWait = cmd.cooldownUntil - now
    local waitTime     = math.max(0, chainWait, cooldownWait)

    DbgLog(string.format("[Commander] [%d] %s | цепь=%.2fс кд=%.2fс ждём=%.2fс",
        CmdState.QueueIndex, cmd.name,
        math.max(0, chainWait), math.max(0, cooldownWait), waitTime))

    CmdState.ScheduledThread = task.delay(waitTime, function()
        if not CmdState.Enabled then return end

        local ok, err = pcall(function()
            local activated = ActivateCommander(cmd)
            if activated then
                CmdState.LastChainTime = os.clock()
                CmdState.RetryCount    = 0
                CmdState.QueueIndex    = (CmdState.QueueIndex % #CmdState.Commanders) + 1
                CmdScheduleNext()
            else
                CmdState.RetryCount += 1
                if CmdState.RetryCount >= CMD_MAX_RETRIES then
                    warn(string.format(
                        "[Commander][WARN] %d неудач подряд, пропуск '%s'",
                        CMD_MAX_RETRIES, cmd.name))
                    CmdState.RetryCount = 0
                    CmdState.QueueIndex = (CmdState.QueueIndex % #CmdState.Commanders) + 1
                end
                CmdState.ScheduledThread = task.delay(1, function()
                    if CmdState.Enabled then CmdScheduleNext() end
                end)
            end
        end)

        if not ok then
            warn("[Commander][ERROR] Шаг: " .. tostring(err))
            CmdState.ScheduledThread = task.delay(2, function()
                if CmdState.Enabled then CmdScheduleNext() end
            end)
        end
    end)
end

-- ═══════════════════════════════════════════════════════════════
-- УПРАВЛЕНИЕ — COMMANDER
-- ═══════════════════════════════════════════════════════════════

local function StartCommander()
    if CmdState.Enabled then return false end
    CmdState.Commanders = ScanCommanders()
    if #CmdState.Commanders == 0 then
        warn("[Commander] Командиры не найдены!")
        return false
    end
    CmdState.Enabled         = true
    CmdState.QueueIndex      = 1
    CmdState.ActivationCount = 0
    CmdState.LastChainTime   = 0
    CmdState.RetryCount      = 0
    for _, cmd in ipairs(CmdState.Commanders) do
        cmd.cooldownUntil = 0
    end
    warn("[Commander] ▶ Запущена цепочка")
    CmdScheduleNext()
    return true
end

local function StopCommander()
    if not CmdState.Enabled then return end
    CmdState.Enabled = false
    if CmdState.ScheduledThread then
        task.cancel(CmdState.ScheduledThread)
        CmdState.ScheduledThread = nil
    end
    warn(string.format("[Commander] ⏹ Остановлена. Активаций: %d",
        CmdState.ActivationCount))
end

-- ═══════════════════════════════════════════════════════════════
-- УПРАВЛЕНИЕ — GLADIATOR
-- ═══════════════════════════════════════════════════════════════

local function StartGladiator()
    if GladState.Enabled then return false end
    GladState.Gladiators = ScanGladiators()
    if #GladState.Gladiators == 0 then
        warn("[Gladiator] Башни не найдены (или все ниже " .. GLAD_MIN_LEVEL .. " ур.)!")
        return false
    end
    GladState.Enabled         = true
    GladState.ActivationCount = 0

    for _, g in ipairs(GladState.Gladiators) do
        g.cooldownUntil = 0
        g.retryCount    = 0
        g.thread        = nil
    end

    warn(string.format("[Gladiator] ▶ Запуск %d независимых потоков",
        #GladState.Gladiators))

    -- Запускаем все потоки ОДНОВРЕМЕННО
    -- task.delay(0) = следующий кадр, без блокировки текущего потока
    -- Минимальный сдвиг 0.05с только чтобы не перегрузить сервер
    -- в самый первый момент (потом они разойдутся по времени сами)
    for i, g in ipairs(GladState.Gladiators) do
        local startOffset = (i - 1) * 0.05  -- 50мс между стартами
        g.thread = task.delay(startOffset, function()
            GladLoop(g)
        end)
    end

    return true
end

local function StopGladiator()
    if not GladState.Enabled then return end
    GladState.Enabled = false
    -- Отменяем все запланированные потоки
    for _, g in ipairs(GladState.Gladiators) do
        if g.thread then
            pcall(task.cancel, g.thread)
            g.thread = nil
        end
    end
    warn(string.format("[Gladiator] ⏹ Остановлен. Активаций: %d",
        GladState.ActivationCount))
end

