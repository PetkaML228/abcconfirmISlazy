--[[
    Commander AutoChain + Gladiator Auto-Ability — TDS: S.O.L.A.R
    Версия: 1.4.0 | UI: Rayfield

    МЕХАНИКА COMMANDER ЦЕПОЧКИ:
    • Кулдаун: 50с | Бафф: 10с | Нужно: 5 командиров
    T=0с → A | T=10с → B | T=20с → C | T=30с → D | T=40с → E
    T=50с → A (кулдаун закончился — цикл замкнулся)

    МЕХАНИКА GLADIATOR:
    • Способность доступна с 3 уровня
    • Кулдаун: 30с | Способность: Warrior's Call
    • Активация последовательная с задержкой 0.6с между башнями
    • После активации всех — каждая башня ждёт свой кулдаун (30.1с)
    • При стане башня пропускается и повторяет попытку через GLAD_STUN_RETRY
    • nil в ответе сервера = перегрузка запросами, решается задержкой 0.6с

    ОПТИМИЗАЦИЯ v1.4:
    • Единый менеджер-поток для Gladiator вместо N параллельных потоков
    • Задержка 0.6с между активациями — сервер успевает обработать запрос
    • Застаненные башни пропускаются в текущем проходе, повторяются отдельно
    • Нет task.wait() — только task.delay()
]]

local function SafeInit()

-- ═══════════════════════════════════════════════════════════════
-- СЕРВИСЫ
-- ═══════════════════════════════════════════════════════════════

local Players, ReplicatedStorage, Workspace
do
    local ok
    ok, Players           = pcall(game.GetService, game, "Players")
    if not ok then error("Players: "           .. tostring(Players))           end
    ok, ReplicatedStorage = pcall(game.GetService, game, "ReplicatedStorage")
    if not ok then error("ReplicatedStorage: " .. tostring(ReplicatedStorage)) end
    ok, Workspace         = pcall(game.GetService, game, "Workspace")
    if not ok then error("Workspace: "         .. tostring(Workspace))         end
end

local LocalPlayer = Players.LocalPlayer
if not LocalPlayer then error("LocalPlayer не найден") end

-- ═══════════════════════════════════════════════════════════════
-- REMOTEFUNC
-- ═══════════════════════════════════════════════════════════════

local RemoteFunction
do
    local Resources = ReplicatedStorage:WaitForChild("Resources", 10)
    if not Resources then error("Resources не найден") end

    local Universal = Resources:FindFirstChild("Universal")
    if Universal then
        local Network = Universal:FindFirstChild("Network")
        if Network then
            RemoteFunction = Network:FindFirstChild("RemoteFunction")
            if RemoteFunction then
                warn("[AutoChain] RF: Resources.Universal.Network")
            end
        end
    end

    if not RemoteFunction then
        local Network = Resources:FindFirstChild("Network")
        if Network then
            RemoteFunction = Network:FindFirstChild("RemoteFunction")
            if RemoteFunction then
                warn("[AutoChain] RF: Resources.Network")
            end
        end
    end

    if not RemoteFunction then error("RemoteFunction не найден") end
end

local TowersFolder = Workspace:WaitForChild("Towers", 10)
if not TowersFolder then error("workspace.Towers не найдена") end

warn("[AutoChain] Инициализация: OK")

-- ═══════════════════════════════════════════════════════════════
-- КОНСТАНТЫ — COMMANDER
-- ═══════════════════════════════════════════════════════════════

local CMD_ABILITY_NAME  = "Call Of Arms"
local CMD_TYPE          = "Commander"
local CMD_BUFF_DURATION = 10.0
local CMD_COOLDOWN      = 50.0
local CMD_LEAD          = 0.1

-- ═══════════════════════════════════════════════════════════════
-- КОНСТАНТЫ — GLADIATOR
-- ═══════════════════════════════════════════════════════════════

local GLAD_ABILITY_NAME   = "Warrior's Call"
local GLAD_TYPE           = "Gladiator"
local GLAD_COOLDOWN       = 30.1  -- с запасом чтобы сервер успел сбросить кд
local GLAD_MIN_LEVEL      = 3     -- способность доступна с 3 уровня
local GLAD_ACTIVATE_DELAY = 0.6   -- задержка между активациями башен
local GLAD_STUN_RETRY     = 2.0   -- через сколько секунд повторить застаненную башню
local GLAD_MAX_RETRIES    = 10    -- максимум повторов стана прежде чем пропустить

-- ═══════════════════════════════════════════════════════════════
-- ОБЩИЕ НАСТРОЙКИ
-- ═══════════════════════════════════════════════════════════════

local CMD_MAX_RETRIES = 10
local debugMode       = false

-- ═══════════════════════════════════════════════════════════════
-- СОСТОЯНИЕ — COMMANDER
-- ═══════════════════════════════════════════════════════════════

local CmdState = {
    Enabled         = false,
    Commanders      = {},
    QueueIndex      = 1,
    ActivationCount = 0,
    ScheduledThread = nil,
    LastChainTime   = 0,
    RetryCount      = 0,
}

-- ═══════════════════════════════════════════════════════════════
-- СОСТОЯНИЕ — GLADIATOR
--
-- Архитектура v1.4:
-- Один менеджер-поток обходит всех гладиаторов по очереди
-- с задержкой GLAD_ACTIVATE_DELAY между каждым.
-- Застаненные башни получают флаг stunRetry и повторяются
-- отдельным task.delay после того как основной проход завершён.
-- ═══════════════════════════════════════════════════════════════

local GladState = {
    Enabled         = false,
    Gladiators      = {},
    ActivationCount = 0,
    ManagerThread   = nil,  -- handle основного менеджер-потока
    StunThreads     = {},   -- handles повторов застаненных башен
}

-- ═══════════════════════════════════════════════════════════════
-- ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
-- ═══════════════════════════════════════════════════════════════

local function GetReplicator(model)
    return model:FindFirstChild("Replicator")
end

local function IsOwned(model)
    local ok, result = pcall(function()
        local rep = GetReplicator(model)
        if not rep then return false end
        local ownerId = rep:GetAttribute("OwnerId")
        if ownerId then return ownerId == LocalPlayer.UserId end
        return rep:GetAttribute("Owner") == LocalPlayer.Name
    end)
    return ok and result
end

local function GetType(model)
    local ok, result = pcall(function()
        local rep = GetReplicator(model)
        if not rep then return "" end
        return rep:GetAttribute("Type") or ""
    end)
    return ok and result or ""
end

local function GetLevel(model)
    local ok, result = pcall(function()
        local rep = GetReplicator(model)
        if not rep then return 0 end
        return rep:GetAttribute("Upgrade") or 0
    end)
    return ok and result or 0
end

local function IsStunned(model)
    local ok, result = pcall(function()
        local rep = GetReplicator(model)
        if not rep then return false end

        local stunned = rep:GetAttribute("Stunned")
        if stunned == true then return true end

        local stunTime = rep:GetAttribute("StunTime")
        if type(stunTime) == "number" and stunTime > os.clock() then
            return true
        end

        local status = rep:GetAttribute("Status")
        if type(status) == "string" and status:lower():find("stun") then
            return true
        end

        return false
    end)
    return ok and result
end

local function DbgLog(msg)
    if debugMode then warn("[AutoChain][DBG] " .. tostring(msg)) end
end

-- ═══════════════════════════════════════════════════════════════
-- СКАНИРОВАНИЕ
-- ═══════════════════════════════════════════════════════════════

local function ScanCommanders()
    local found = {}
    local ok, err = pcall(function()
        for _, model in ipairs(TowersFolder:GetChildren()) do
            if model:IsA("Model")
            and IsOwned(model)
            and GetType(model) == CMD_TYPE
            then
                table.insert(found, {
                    model         = model,
                    name          = model.Name,
                    level         = GetLevel(model),
                    cooldownUntil = 0,
                })
            end
        end
    end)
    if not ok then
        warn("[Commander] Ошибка сканирования: " .. tostring(err))
    end
    table.sort(found, function(a, b) return a.level > b.level end)
    warn(string.format("[Commander] Найдено: %d", #found))
    for i, c in ipairs(found) do
        warn(string.format("  [%d] %s (ур.%d)", i, c.name, c.level))
    end
    if #found > 0 and #found < 5 then
        warn(string.format("[Commander][WARN] %d/5 — разрыв %.0fс",
            #found, CMD_COOLDOWN - (#found * CMD_BUFF_DURATION)))
    end
    return found
end

local function ScanGladiators()
    local found   = {}
    local skipped = 0
    local ok, err = pcall(function()
        for _, model in ipairs(TowersFolder:GetChildren()) do
            if model:IsA("Model")
            and IsOwned(model)
            and GetType(model) == GLAD_TYPE
            then
                local level = GetLevel(model)
                if level >= GLAD_MIN_LEVEL then
                    table.insert(found, {
                        model         = model,
                        name          = model.Name,
                        level         = level,
                        cooldownUntil = 0,
                        stunRetries   = 0,
                        -- inStunRetry = true означает что башня уже
                        -- обрабатывается отдельным stun-потоком
                        inStunRetry   = false,
                    })
                else
                    skipped += 1
                    DbgLog(string.format("[Gladiator] Пропущен ур.%d: %s",
                        level, model.Name))
                end
            end
        end
    end)
    if not ok then
        warn("[Gladiator] Ошибка сканирования: " .. tostring(err))
    end
    table.sort(found, function(a, b) return a.level > b.level end)
    warn(string.format("[Gladiator] Найдено: %d (низкий ур.: %d)",
        #found, skipped))
    for i, g in ipairs(found) do
        warn(string.format("  [%d] %s (ур.%d)", i, g.name, g.level))
    end
    if skipped > 0 then
        warn(string.format("[Gladiator][INFO] %d башен ниже %d ур. пропущено",
            skipped, GLAD_MIN_LEVEL))
    end
    return found
end

-- ═══════════════════════════════════════════════════════════════
-- АКТИВАЦИЯ — COMMANDER
-- ═══════════════════════════════════════════════════════════════

local function ActivateCommander(cmd)
    if not cmd.model or not cmd.model.Parent then
        warn("[Commander] Удалён: " .. cmd.name)
        return false
    end

    local ok, result = pcall(function()
        return RemoteFunction:InvokeServer(
            "Troops", "Abilities", "Activate",
            { Name = CMD_ABILITY_NAME, Troop = cmd.model }
        )
    end)

    DbgLog(string.format("[Commander] '%s': ok=%s result=%s",
        cmd.name, tostring(ok), tostring(result)))

    if not ok then
        warn("[Commander] Ошибка вызова: " .. tostring(result))
        return false
    end
    if result == false then
        DbgLog("[Commander] Отклонено: " .. cmd.name)
        return false
    end
    if type(result) == "string"
    and (result:lower():find("cooldown") or result:lower():find("error")) then
        DbgLog("[Commander] Ошибка сервера: " .. result)
        return false
    end

    cmd.cooldownUntil         = os.clock() + CMD_COOLDOWN
    CmdState.ActivationCount += 1
    CmdState.RetryCount       = 0
    warn(string.format("[Commander] ✓ %s (всего: %d)",
        cmd.name, CmdState.ActivationCount))
    return true
end

-- ═══════════════════════════════════════════════════════════════
-- АКТИВАЦИЯ — GLADIATOR (одна башня, низкоуровневая функция)
--
-- Возвращает:
--   "ok"       — успешно активировано
--   "stun"     — башня застанена (локально или сервер отклонил)
--   "cooldown" — кулдаун ещё не истёк
--   "nil"      — сервер вернул nil (перегрузка) — нужна пауза
--   "removed"  — башня удалена с карты
--   "error"    — pcall упал
-- ═══════════════════════════════════════════════════════════════

local function ActivateGladiator(g)
    if not g.model or not g.model.Parent then
        return "removed"
    end

    if GetLevel(g.model) < GLAD_MIN_LEVEL then
        DbgLog("[Gladiator] Уровень < " .. GLAD_MIN_LEVEL .. ": " .. g.name)
        return "cooldown"
    end

    if IsStunned(g.model) then
        DbgLog("[Gladiator] Застанен локально: " .. g.name)
        return "stun"
    end

    local now = os.clock()
    if g.cooldownUntil > now then
        DbgLog(string.format("[Gladiator] КД %.2fс: %s",
            g.cooldownUntil - now, g.name))
        return "cooldown"
    end

    local ok, result = pcall(function()
        return RemoteFunction:InvokeServer(
            "Troops", "Abilities", "Activate",
            { Name = GLAD_ABILITY_NAME, Troop = g.model }
        )
    end)

    DbgLog(string.format("[Gladiator] '%s': ok=%s result=%s",
        g.name, tostring(ok), tostring(result)))

    if not ok then
        warn("[Gladiator] Ошибка pcall: " .. tostring(result))
        return "error"
    end

    -- nil = сервер перегружен запросами, нужна пауза
    if result == nil then
        warn(string.format("[Gladiator] nil ответ '%s' — сервер перегружен",
            g.name))
        return "nil"
    end

    if result == false then
        DbgLog("[Gladiator] false от сервера (стан?): " .. g.name)
        return "stun"
    end

    if type(result) == "string" then
        local lower = result:lower()
        if lower:find("cooldown") then return "cooldown" end
        if lower:find("stun")     then return "stun"     end
        if lower:find("error")    then return "error"    end
    end

    -- Успех
    g.cooldownUntil           = os.clock() + GLAD_COOLDOWN
    g.stunRetries             = 0
    g.inStunRetry             = false
    GladState.ActivationCount += 1
    warn(string.format("[Gladiator] ✓ %s (всего: %d)",
        g.name, GladState.ActivationCount))
    return "ok"
end

-- ═══════════════════════════════════════════════════════════════
-- GLADIATOR — МЕНЕДЖЕР
--
-- Принцип работы:
--
-- 1. Менеджер делает ОДИН проход по всем гладиаторам
-- 2. Между каждой активацией — пауза GLAD_ACTIVATE_DELAY (0.6с)
-- 3. Застаненные башни пропускаются → получают stun-поток
-- 4. Башни на кулдауне пропускаются → менеджер сам вернётся к ним
-- 5. После прохода менеджер считает когда раньше всего истечёт
--    кулдаун у следующей башни и засыпает до этого момента
-- 6. nil-ответ = увеличиваем задержку на 0.5с для следующего прохода
--
-- Stun-потоки:
-- Каждая застаненная башня получает отдельный task.delay поток
-- который повторяет попытку через GLAD_STUN_RETRY секунд.
-- Если стан снят — башня активируется и помечается cooldownUntil.
-- ═══════════════════════════════════════════════════════════════

-- forward declaration
local GladManager

-- Stun-поток для одной застаненной башни
local function GladStunRetryLoop(g)
    if not GladState.Enabled then
        g.inStunRetry = false
        return
    end
    if not g.model or not g.model.Parent then
        g.inStunRetry = false
        warn("[Gladiator] Stun-поток: башня удалена " .. tostring(g.name))
        return
    end

    local status = ActivateGladiator(g)

    if status == "ok" then
        g.inStunRetry = false
        DbgLog("[Gladiator] Stun-поток: успех " .. g.name)

    elseif status == "stun" or status == "nil" then
        g.stunRetries = (g.stunRetries or 0) + 1
        if g.stunRetries >= GLAD_MAX_RETRIES then
            -- Слишком долгий стан — ждём полный кулдаун
            warn(string.format(
                "[Gladiator] '%s' в стане %d попыток → сброс через %.0fс",
                g.name, g.stunRetries, GLAD_COOLDOWN))
            g.stunRetries = 0
            g.inStunRetry = false
            -- Башня вернётся в основной проход менеджера
            g.cooldownUntil = os.clock() + GLAD_COOLDOWN
        else
            DbgLog(string.format("[Gladiator] Stun-поток '%s' попытка %d/%d",
                g.name, g.stunRetries, GLAD_MAX_RETRIES))
            GladState.StunThreads[g] = task.delay(GLAD_STUN_RETRY, function()
                GladStunRetryLoop(g)
            end)
        end

    elseif status == "cooldown" then
        -- Стан снят но кулдаун — возвращаем башню менеджеру
        g.inStunRetry = false
        DbgLog("[Gladiator] Stun-поток: кд " .. g.name)

    elseif status == "removed" then
        g.inStunRetry = false

    else
        -- error — пауза и повтор
        g.stunRetries = (g.stunRetries or 0) + 1
        GladState.StunThreads[g] = task.delay(GLAD_STUN_RETRY, function()
            GladStunRetryLoop(g)
        end)
    end
end

-- Основной менеджер-поток
GladManager = function()
    if not GladState.Enabled then return end

    -- Чистим удалённые башни
    for i = #GladState.Gladiators, 1, -1 do
        local g = GladState.Gladiators[i]
        if not g.model or not g.model.Parent then
            warn("[Gladiator] Менеджер: удалена " .. tostring(g.name))
            -- Отменяем stun-поток если был
            if GladState.StunThreads[g] then
                pcall(task.cancel, GladState.StunThreads[g])
                GladState.StunThreads[g] = nil
            end
            table.remove(GladState.Gladiators, i)
        end
    end

    if #GladState.Gladiators == 0 then
        warn("[Gladiator] Все башни удалены. Остановка.")
        GladState.Enabled = false
        return
    end

    local now           = os.clock()
    local activated     = 0
    local skippedStun   = 0
    local skippedCD     = 0
    local nilCount      = 0
    local nextCDTime    = math.huge  -- когда раньше всего истечёт КД

    -- ── Проход по всем гладиаторам ──────────────────────────────
    local i = 1
    local function processNext()
        if not GladState.Enabled then return end
        if i > #GladState.Gladiators then
            -- Все башни обработаны — планируем следующий проход
            -- Считаем сколько ждать до следующей готовой башни
            local sleepTime
            if nextCDTime == math.huge then
                -- Все только что активированы — ждём стандартный кулдаун
                sleepTime = GLAD_COOLDOWN
            else
                sleepTime = math.max(0.5, nextCDTime - os.clock())
            end

            DbgLog(string.format(
                "[Gladiator] Проход: ✓%d стан%d кд%d nil%d → сон %.1fс",
                activated, skippedStun, skippedCD, nilCount, sleepTime))

            if activated > 0 or skippedCD > 0 then
                warn(string.format(
                    "[Gladiator] Проход завершён: активировано %d, пропущено стан=%d кд=%d nil=%d",
                    activated, skippedStun, skippedCD, nilCount))
            end

            GladState.ManagerThread = task.delay(sleepTime, GladManager)
            return
        end

        local g = GladState.Gladiators[i]
        i += 1

        -- Башня уже обрабатывается stun-потоком — пропускаем
        if g.inStunRetry then
            skippedStun += 1
            DbgLog("[Gladiator] Пропуск (stun-поток активен): " .. g.name)
            processNext()
            return
        end

        -- Башня на кулдауне — пропускаем, запоминаем время
        local cdLeft = g.cooldownUntil - os.clock()
        if cdLeft > 0 then
            skippedCD += 1
            if g.cooldownUntil < nextCDTime then
                nextCDTime = g.cooldownUntil
            end
            DbgLog(string.format("[Gladiator] Пропуск КД %.1fс: %s",
                cdLeft, g.name))
            processNext()
            return
        end

        -- Пробуем активировать
        local ok, err = pcall(function()
            local status = ActivateGladiator(g)

            if status == "ok" then
                activated += 1
                -- Следующая башня через 0.6с
                task.delay(GLAD_ACTIVATE_DELAY, processNext)

            elseif status == "stun" then
                -- Запускаем отдельный stun-поток для этой башни
                skippedStun += 1
                g.inStunRetry = true
                g.stunRetries = 0
                GladState.StunThreads[g] = task.delay(
                    GLAD_STUN_RETRY, function()
                        GladStunRetryLoop(g)
                    end)
                -- Следующая башня сразу (не ждём — стан не наша вина)
                processNext()

            elseif status == "nil" then
                -- Сервер перегружен — делаем бо́льшую паузу перед следующей
                nilCount += 1
                warn(string.format(
                    "[Gladiator] nil #%d — пауза %.1fс перед следующей башней",
                    nilCount, GLAD_ACTIVATE_DELAY + 0.5))
                -- Возвращаем эту башню обратно — попробуем в следующем проходе
                -- (кулдаун не ставим, башня останется готовой)
                task.delay(GLAD_ACTIVATE_DELAY + 0.5, processNext)

            elseif status == "cooldown" then
                skippedCD += 1
                if g.cooldownUntil < nextCDTime then
                    nextCDTime = g.cooldownUntil
                end
                processNext()

            elseif status == "removed" then
                -- Башня исчезла в процессе — уберём на следующем проходе
                processNext()

            else
                -- error — пауза 1с и продолжаем
                warn("[Gladiator] Ошибка активации " .. g.name)
                task.delay(1, processNext)
            end
        end)

        if not ok then
            warn("[Gladiator] pcall упал: " .. tostring(err))
            task.delay(1, processNext)
        end
    end

    -- Запуск прохода
    processNext()
end

-- ═══════════════════════════════════════════════════════════════
-- COMMANDER ЦЕПОЧКА
-- ═══════════════════════════════════════════════════════════════

local function CmdScheduleNext()
    if not CmdState.Enabled then return end
    if #CmdState.Commanders == 0 then return end

    for i = #CmdState.Commanders, 1, -1 do
        if not CmdState.Commanders[i].model.Parent then
            warn("[Commander] Удалена: " .. CmdState.Commanders[i].name)
            table.remove(CmdState.Commanders, i)
        end
    end

    if #CmdState.Commanders == 0 then
        warn("[Commander] Все башни удалены. Остановка.")
        CmdState.Enabled = false
        return
    end

    if CmdState.QueueIndex > #CmdState.Commanders then
        CmdState.QueueIndex = 1
    end

    local cmd = CmdState.Commanders[CmdState.QueueIndex]
    local now = os.clock()

    local chainWait    = CmdState.LastChainTime == 0
        and 0
        or (CmdState.LastChainTime + CMD_BUFF_DURATION - CMD_LEAD) - now
    local cooldownWait = cmd.cooldownUntil - now
    local waitTime     = math.max(0, chainWait, cooldownWait)

    DbgLog(string.format("[Commander] [%d] %s | цепь=%.2fс кд=%.2fс ждём=%.2fс",
        CmdState.QueueIndex, cmd.name,
        math.max(0, chainWait), math.max(0, cooldownWait), waitTime))

    CmdState.ScheduledThread = task.delay(waitTime, function()
        if not CmdState.Enabled then return end

        local ok, err = pcall(function()
            local activated = ActivateCommander(cmd)
            if activated then
                CmdState.LastChainTime = os.clock()
                CmdState.RetryCount    = 0
                CmdState.QueueIndex    = (CmdState.QueueIndex % #CmdState.Commanders) + 1
                CmdScheduleNext()
            else
                CmdState.RetryCount += 1
                if CmdState.RetryCount >= CMD_MAX_RETRIES then
                    warn(string.format(
                        "[Commander][WARN] %d неудач подряд, пропуск '%s'",
                        CMD_MAX_RETRIES, cmd.name))
                    CmdState.RetryCount = 0
                    CmdState.QueueIndex =
                        (CmdState.QueueIndex % #CmdState.Commanders) + 1
                end
                CmdState.ScheduledThread = task.delay(1, function()
                    if CmdState.Enabled then CmdScheduleNext() end
                end)
            end
        end)

        if not ok then
            warn("[Commander][ERROR] Шаг: " .. tostring(err))
            CmdState.ScheduledThread = task.delay(2, function()
                if CmdState.Enabled then CmdScheduleNext() end
            end)
        end
    end)
end

-- ═══════════════════════════════════════════════════════════════
-- УПРАВЛЕНИЕ — COMMANDER
-- ═══════════════════════════════════════════════════════════════

local function StartCommander()
    if CmdState.Enabled then return false end
    CmdState.Commanders = ScanCommanders()
    if #CmdState.Commanders == 0 then
        warn("[Commander] Командиры не найдены!")
        return false
    end
    CmdState.Enabled         = true
    CmdState.QueueIndex      = 1
    CmdState.ActivationCount = 0
    CmdState.LastChainTime   = 0
    CmdState.RetryCount      = 0
    for _, cmd in ipairs(CmdState.Commanders) do
        cmd.cooldownUntil = 0
    end
    warn("[Commander] ▶ Запущена цепочка")
    CmdScheduleNext()
    return true
end

local function StopCommander()
    if not CmdState.Enabled then return end
    CmdState.Enabled = false
    if CmdState.ScheduledThread then
        task.cancel(CmdState.ScheduledThread)
        CmdState.ScheduledThread = nil
    end
    warn(string.format("[Commander] ⏹ Остановлена. Активаций: %d",
        CmdState.ActivationCount))
end

-- ═══════════════════════════════════════════════════════════════
-- УПРАВЛЕНИЕ — GLADIATOR
-- ═══════════════════════════════════════════════════════════════

local function StartGladiator()
    if GladState.Enabled then return false end
    GladState.Gladiators = ScanGladiators()
    if #GladState.Gladiators == 0 then
        warn("[Gladiator] Башни не найдены (нужен ур." .. GLAD_MIN_LEVEL .. "+)!")
        return false
    end
    GladState.Enabled         = true
    GladState.ActivationCount = 0
    GladState.StunThreads     = {}

    for _, g in ipairs(GladState.Gladiators) do
        g.cooldownUntil = 0
        g.stunRetries   = 0
        g.inStunRetry   = false
    end

    warn(string.format("[Gladiator] ▶ Запуск менеджера (%d башен, задержка %.1fс)",
        #GladState.Gladiators, GLAD_ACTIVATE_DELAY))
    warn(string.format("[Gladiator] Полное время прохода: ~%.1fс",
        #GladState.Gladiators * GLAD_ACTIVATE_DELAY))

    GladState.ManagerThread = task.delay(0, GladManager)
    return true
end

local function StopGladiator()
    if not GladState.Enabled then return end
    GladState.Enabled = false

    -- Отменяем менеджер-поток
    if GladState.ManagerThread then
        pcall(task.cancel, GladState.ManagerThread)
        GladState.ManagerThread = nil
    end

    -- Отменяем все stun-потоки
    for g, thread in pairs(GladState.StunThreads) do
        pcall(task.cancel, thread)
        if g then g.inStunRetry = false end
    end
    GladState.StunThreads = {}

    warn(string.format("[Gladiator] ⏹ Остановлен. Активаций: %d",
        GladState.ActivationCount))
end

