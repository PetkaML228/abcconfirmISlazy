    Main:CreateSection("Gladiator Auto-Ability")

    Main:CreateToggle({
        Name         = "Warrior's Call (Gladiator)",
        CurrentValue = false,
        Flag         = "GladiatorToggle",
        Callback     = function(on)
            if on then
                local started = StartGladiator()
                Rayfield:Notify({
                    Title    = "Gladiator",
                    Content  = started
                        and string.format("Запущен! Башен: %d", #GladState.Gladiators)
                        or  "Gladiator'ы не найдены",
                    Duration = 4,
                })
            else
                StopGladiator()
                Rayfield:Notify({
                    Title    = "Gladiator",
                    Content  = string.format("Остановлен. Активаций: %d",
                        GladState.ActivationCount),
                    Duration = 3,
                })
            end
        end,
    })

    Main:CreateButton({
        Name     = "Пересканировать Gladiator'ы",
        Callback = function()
            local was = GladState.Enabled
            if was then StopGladiator() end
            -- Небольшая пауза чтобы потоки успели остановиться
            task.delay(0.3, function()
                GladState.Gladiators = ScanGladiators()
                Rayfield:Notify({
                    Title    = "Сканирование",
                    Content  = string.format("Gladiator'ов: %d", #GladState.Gladiators),
                    Duration = 4,
                })
                if was and #GladState.Gladiators > 0 then StartGladiator() end
            end)
        end,
    })

    Main:CreateSection("Настройки Gladiator")

    Main:CreateSlider({
        Name         = "Кулдаун Gladiator (сек)",
        Range        = {20, 60},
        Increment    = 1,
        Suffix       = "с",
        CurrentValue = GLAD_COOLDOWN,
        Flag         = "GladCD",
        Callback     = function(v) GLAD_COOLDOWN = v end,
    })

    Main:CreateSlider({
        Name         = "Повтор при стане (сек)",
        Range        = {0.5, 5.0},
        Increment    = 0.5,
        Suffix       = "с",
        CurrentValue = GLAD_STUN_RETRY,
        Flag         = "GladStunRetry",
        Callback     = function(v) GLAD_STUN_RETRY = v end,
    })

    -- ── Отладка ──────────────────────────────────────────────────

    local Debug = Window:CreateTab("Отладка", nil)

    Debug:CreateToggle({
        Name         = "Подробный лог (warn)",
        CurrentValue = false,
        Flag         = "DebugLog",
        Callback     = function(v) debugMode = v end,
    })

    Debug:CreateButton({
        Name     = "Статус Commander'ов",
        Callback = function()
            local now = os.clock()
            warn("[Commander] ═══ Статус ═══")
            warn(string.format("  %s | Активаций: %d",
                CmdState.Enabled and "АКТИВНА" or "СТОП",
                CmdState.ActivationCount))
            for i, cmd in ipairs(CmdState.Commanders) do
                warn(string.format("  [%d]%s %s (ур.%d) | КД: %.1fс",
                    i, i == CmdState.QueueIndex and ">" or " ",
                    cmd.name, cmd.level,
                    math.max(0, cmd.cooldownUntil - now)))
            end
            if CmdState.LastChainTime ~= 0 then
                warn(string.format("  Следующая через: %.1fс",
                    math.max(0, CmdState.LastChainTime
                        + CMD_BUFF_DURATION - CMD_LEAD - now)))
            end
            warn("[Commander] ═════════════")
            Rayfield:Notify({
                Title    = "Commander",
                Content  = "Смотри Output / F9",
                Duration = 3,
            })
        end,
    })

    Debug:CreateButton({
        Name     = "Статус Gladiator'ов",
        Callback = function()
            local now = os.clock()
            warn("[Gladiator] ═══ Статус ═══")
            warn(string.format("  %s | Активаций: %d",
                GladState.Enabled and "АКТИВЕН" or "СТОП",
                GladState.ActivationCount))
            for i, g in ipairs(GladState.Gladiators) do
                local stunned = IsStunned(g.model) and "⚡СТАН" or "OK"
                warn(string.format("  [%d] %s (ур.%d) | КД: %.1fс | %s",
                    i, g.name, g.level,
                    math.max(0, g.cooldownUntil - now),
                    stunned))
            end
            warn("[Gladiator] ═════════════")
            Rayfield:Notify({
                Title    = "Gladiator",
                Content  = "Смотри Output / F9",
                Duration = 3,
            })
        end,
    })

    Debug:CreateButton({
        Name     = "Тест: активировать всех сейчас",
        Callback = function()
            local cmdCount  = 0
            local gladCount = 0

            -- Тест Commander'ов
            for _, cmd in ipairs(CmdState.Commanders) do
                if ActivateCommander(cmd) then cmdCount += 1 end
                task.wait(0.2)
            end

            -- Тест Gladiator'ов
            for _, g in ipairs(GladState.Gladiators) do
                if ActivateGladiator(g) == "ok" then gladCount += 1 end
                task.wait(0.2)
            end

            Rayfield:Notify({
                Title    = "Тест",
                Content  = string.format("CMD: %d/%d | GLAD: %d/%d",
                    cmdCount,  #CmdState.Commanders,
                    gladCount, #GladState.Gladiators),
                Duration = 5,
            })
        end,
    })

    -- ── Помощь ───────────────────────────────────────────────────

    local Help = Window:CreateTab("Помощь", nil)

    Help:CreateSection("Быстрый старт")
    Help:CreateLabel("1. Разместить башни на карте")
    Help:CreateLabel("2. Нажать Пересканировать")
    Help:CreateLabel("3. Включить нужные тогглы")

    Help:CreateSection("Commander — математика")
    Help:CreateLabel("КД=50с | Бафф=10с")
    Help:CreateLabel("5 CMD: 5×10=50с → 100% покрытие")
    Help:CreateLabel("4 CMD: 4×10=40с → разрыв 10с")

    Help:CreateSection("Gladiator — стан")
    Help:CreateLabel("При стане: повтор каждые N сек")
    Help:CreateLabel("Настрой 'Повтор при стане' под волну")
    Help:CreateLabel("После 15 попыток — пауза 30с")

    Help:CreateSection("Если способность не активируется")
    Help:CreateLabel("• Проверь Output (F9) с включённым логом")
    Help:CreateLabel("• Нажми Пересканировать после установки башен")
    Help:CreateLabel("• Убедись что башни твои (не союзника)")

end)

if not uiOk then
    warn("[AutoChain][ERROR] UI: " .. tostring(uiErr))
end

